  hasActiveRelationshipAction: function (
    name,
    input,
    output,
    patterns,
    options
  ) {
    const settings = options || {};

    const inputText = this.normalizeInteractionText(input);
    const outputText = this.normalizeInteractionText(output);

    const aliases = this.getAliases(name);
    const escapedAliases = aliases.map(alias =>
      this.escapeRegex(alias)
    );

    if (!escapedAliases.length) return false;

    const outputSubjectRegex = new RegExp(
      "\\b(?:" +
        escapedAliases.join("|") +
        "|they|he|she|you|we" +
      ")\\b",
      "i"
    );

    const inputTargetRegex = new RegExp(
      "\\b(?:" +
        escapedAliases.join("|") +
        "|her|him|them" +
      ")\\b",
      "i"
    );

    const inputSharedRegex =
      /\b(?:together|between us|just the two of us|one[- ]on[- ]one|alone together)\b/i;

    const intentPattern =
      /\b(?:would|could|might|may|should|will|want(?:s)? to|wanted to|hope(?:s)? to|hoped to|plan(?:s)? to|planned to|intend(?:s|ed)? to|wish(?:es|ed)? to|consider(?:s|ed)?|think(?:s)? about|thought about|try(?:ies|ied|ing)? to|attempt(?:s|ed|ing)? to|almost|nearly)\b/i;

    const negationPattern =
      /\b(?:not|never|don't|doesn't|didn't|won't|can't|cannot|no longer)\b/i;

    const shouldIgnoreIntent =
      settings.ignoreIntent !== false;

    const shouldBlockNegation =
      settings.blockNegation === true;

    const allowPreviousSubject =
      settings.allowPreviousSubject !== false;

    const allowUntargetedInput =
      settings.allowUntargetedInput === true;

    const untargetedInputPatterns =
      Array.isArray(settings.untargetedInputPatterns)
        ? settings.untargetedInputPatterns
        : patterns;

    const actionAllowed = function (sentence, actionMatch) {
      if (!actionMatch) return false;

      const beforeAction =
        sentence.slice(0, actionMatch.index);

      if (shouldIgnoreIntent) {
        const recentBeforeAction =
          beforeAction.slice(-70);

        if (intentPattern.test(recentBeforeAction)) {
          return false;
        }
      }

      if (shouldBlockNegation) {
        const recentBeforeAction =
          beforeAction.slice(-50);

        if (negationPattern.test(recentBeforeAction)) {
          return false;
        }
      }

      return true;
    };

    const scanOutput = function () {
      if (!outputText) return false;

      const sentences =
        this.splitInteractionSentences(outputText);

      for (let index = 0; index < sentences.length; index++) {
        const sentence = sentences[index];
        const previousSentence =
          index > 0 ? sentences[index - 1] : "";

        if (this.isRetrospectiveRelationshipSentence(sentence)) {
          continue;
        }

        const subjectPresent =
          outputSubjectRegex.test(sentence) ||
          (
            allowPreviousSubject &&
            previousSentence &&
            outputSubjectRegex.test(previousSentence)
          );

        if (!subjectPresent) {
          continue;
        }

        for (const pattern of patterns) {
          const actionMatch =
            sentence.match(pattern);

          if (
            actionAllowed(
              sentence,
              actionMatch
            )
          ) {
            return true;
          }
        }
      }

      return false;
    }.bind(this);

    const scanInput = function () {
      if (!inputText) return false;

      const sentences =
        this.splitInteractionSentences(inputText);

      for (const sentence of sentences) {
        if (this.isInputDirective(sentence)) {
          continue;
        }

        if (this.isRetrospectiveRelationshipSentence(sentence)) {
          continue;
        }

        const targetPresent =
          inputTargetRegex.test(sentence) ||
          inputSharedRegex.test(sentence);

        if (targetPresent) {
          for (const pattern of patterns) {
            const actionMatch =
              sentence.match(pattern);

            if (
              actionAllowed(
                sentence,
                actionMatch
              )
            ) {
              return true;
            }
          }
        }

        if (allowUntargetedInput) {
          for (const pattern of untargetedInputPatterns) {
            const actionMatch =
              sentence.match(pattern);

            if (
              actionAllowed(
                sentence,
                actionMatch
              )
            ) {
              return true;
            }
          }
        }
      }

      return false;
    }.bind(this);

    return scanInput() || scanOutput();
  },

