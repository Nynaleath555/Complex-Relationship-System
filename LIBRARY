/* =========================================================
   COMPLEX REL
   Reusable relationship system for AI Dungeon.
   
   IMPORTANT:
   Paste the original Inner Self library ABOVE this section.
   Do not modify the Inner Self library itself.
   
   Complex REL uses its own persistent state and does not
   depend on Inner Self internals.
   ========================================================= */


/* =========================================================
   RELATIONSHIP SYSTEM
   ========================================================= */

const REL = {

  /* ---------------------------------------------------------
     CONFIGURATION
     --------------------------------------------------------- */

  CONFIG_CARD_KEY: "__REL_CONFIG__",

  CONFIG_CARD_TYPE: "REL_CONFIG",

  STATUS_CARD_KEY: "__REL_STATUS__",

  STATUS_CARD_TYPE: "REL_STATUS",

  CONFIG_PLACEHOLDER: "[Write character name here]",


  /* ---------------------------------------------------------
     INIT
     --------------------------------------------------------- */

  init: function () {

    if (!state.relationships) {

      state.relationships = {
        romanticInterest: "",
        characters: {},
        lastInput: "",
        lastOutput: "",
        turn: 0
      };

    }

    if (!state.relationships.characters) {
      state.relationships.characters = {};
    }

    if (typeof state.relationships.romanticInterest !== "string") {
      state.relationships.romanticInterest = "";
    }

    if (typeof state.relationships.lastInput !== "string") {
      state.relationships.lastInput = "";
    }

    if (typeof state.relationships.lastOutput !== "string") {
      state.relationships.lastOutput = "";
    }

    if (
      typeof state.relationships.turn !== "number" ||
      !isFinite(state.relationships.turn)
    ) {
      state.relationships.turn = 0;
    }

    return state.relationships;
  },


  /* ---------------------------------------------------------
     BASIC HELPERS
     --------------------------------------------------------- */

  clamp: function (value, min, max) {

    return Math.max(
      min,
      Math.min(
        max,
        Number(value || 0)
      )
    );

  },


  hasAny: function (text, words) {

    const source =
      String(text || "").toLowerCase();

    return (words || []).some(word =>
      source.includes(
        String(word || "").toLowerCase()
      )
    );

  },


  /* ---------------------------------------------------------
     CONFIG CARD
     --------------------------------------------------------- */

  getConfigCard: function () {

    for (
      let index = 0;
      index < (storyCards || []).length;
      index++
    ) {

      const card =
        storyCards[index];

      const keys =
        String(card.keys || "")
          .split(",")
          .map(value => value.trim());

      if (
        keys.includes(
          this.CONFIG_CARD_KEY
        ) ||
        card.type === this.CONFIG_CARD_TYPE
      ) {

        return {
          card: card,
          index: index
        };

      }

    }

    return null;

  },


  ensureConfigCard: function () {

    const existing =
      this.getConfigCard();

    if (existing) {
      return existing;
    }

    const entry =
      "Complex REL configuration card.\n\n" +
      "This card is used internally by the relationship system. " +
      "Write the name of the single romantic interest in the " +
      "Notes field. The system reads the last valid line of Notes " +
      "and begins tracking that character automatically.\n\n" +
      "The configuration card does not need manual Triggers.";

    const newIndex =
      addStoryCard(
        this.CONFIG_CARD_KEY,
        entry,
        this.CONFIG_CARD_TYPE
      );

    if (
      newIndex !== false &&
      storyCards &&
      storyCards[newIndex]
    ) {

      storyCards[newIndex].description =
        "Write the name of the single romantic interest on a new line at the very bottom of Notes.\n\n" +
        this.CONFIG_PLACEHOLDER;

      storyCards[newIndex].title =
        "Complex REL Configuration";

    }

    if (newIndex !== false) {

      log(
        "REL CONFIG CREATED — index=" +
        String(newIndex)
      );

      return {
        card: storyCards[newIndex],
        index: newIndex
      };

    }

    return this.getConfigCard();

  },


  /* ---------------------------------------------------------
     CONFIG NAME PARSING
     --------------------------------------------------------- */

  getConfiguredInterest: function () {

    const config =
      this.getConfigCard();

    if (!config || !config.card) {
      return "";
    }

    /*
      In AI Dungeon Story Card data, the user-facing Notes
      field is represented as "description".
    */

    const notes =
      String(
        config.card.description || ""
      );

    const lines =
      notes
        .split(/\r?\n/)
        .map(line => line.trim())
        .filter(Boolean);

    for (
      let index = lines.length - 1;
      index >= 0;
      index--
    ) {

      const line =
        lines[index];

      if (!line) {
        continue;
      }

      if (
        line === this.CONFIG_PLACEHOLDER
      ) {
        continue;
      }

      if (
        /^\[.*\]$/.test(line)
      ) {
        continue;
      }

      if (
        line.toLowerCase().includes(
          "write the name"
        )
      ) {
        continue;
      }

      if (
        line.toLowerCase().includes(
          "romantic interest"
        ) &&
        line.toLowerCase().includes(
          "notes"
        )
      ) {
        continue;
      }

      return line;

    }

    return "";

  },


  /* ---------------------------------------------------------
     ROMANTIC INTEREST DETECTION
     --------------------------------------------------------- */

  getInterestFromText: function (contextText) {

    const relationships =
      this.init();

    /*
      Once a romantic interest has been identified,
      it remains persistent for the adventure.
    */

    if (
      relationships.romanticInterest
    ) {
      return relationships.romanticInterest;
    }

    const configuredName =
      this.getConfiguredInterest();

    if (!configuredName) {
      return "";
    }

    const source =
      String(contextText || "");

    /*
      Use the configured character name as the primary
      detection mechanism.
    */

    if (
      this.nameMatches(
        source,
        configuredName
      )
    ) {

      relationships.romanticInterest =
        configuredName;

      return configuredName;

    }

    /*
      If the configured name is not present in recent text,
      initialize the relationship anyway once the name has
      been configured.
      
      This allows tracking to begin immediately instead of
      waiting for the character's name to appear naturally.
    */

    relationships.romanticInterest =
      configuredName;

    return configuredName;

  },


  detectInterest: function (
    cards,
    contextText
  ) {

    const relationships =
      this.init();

    /*
      Existing persistent value always wins.
    */

    if (
      relationships.romanticInterest
    ) {

      return relationships.romanticInterest;

    }

    /*
      Primary configuration source:
      the character name written in the Config Card Notes.
    */

    const configuredName =
      this.getConfiguredInterest();

    if (configuredName) {

      relationships.romanticInterest =
        configuredName;

      return configuredName;

    }


    /*
      Legacy fallback for scenarios that previously used
      the original Nate/Nat implementation.
    */

    const source =
      String(contextText || "");

    const nateMatches =
      /\bnate\b/i.test(source) ||
      /\bnathan\b/i.test(source) ||
      /\bnathaniel\b/i.test(source) ||
      /\bnate\s+drake\b/i.test(source) ||
      /\bnathan\s+drake\b/i.test(source) ||
      /\bnathaniel\s+drake\b/i.test(source);

    const natMatches =
      /\bnat\b/i.test(source) ||
      /\bnatasha\b/i.test(source) ||
      /\bnat\s+drake\b/i.test(source) ||
      /\bnatasha\s+drake\b/i.test(source);

    if (
      nateMatches &&
      !natMatches
    ) {

      relationships.romanticInterest =
        "Nate Drake";

      return "Nate Drake";

    }

    if (
      natMatches &&
      !nateMatches
    ) {

      relationships.romanticInterest =
        "Nat Drake";

      return "Nat Drake";

    }


    /*
      Legacy Story Card fallback.
    */

    const candidates = [];

    for (
      const card of cards || []
    ) {

      const keys =
        String(card.keys || "");

      if (!keys) {
        continue;
      }

      const keyList =
        keys
          .split(",")
          .map(key => key.trim())
          .filter(Boolean);

      for (
        const key of keyList
      ) {

        const normalizedKey =
          key
            .toLowerCase()
            .replace(/\s+/g, " ")
            .trim();

        if (
          normalizedKey === "nate" ||
          normalizedKey === "nathan" ||
          normalizedKey === "nathaniel" ||
          normalizedKey === "nate drake" ||
          normalizedKey === "nathan drake" ||
          normalizedKey === "nathaniel drake"
        ) {

          candidates.push(
            "Nate Drake"
          );

          break;

        }

        if (
          normalizedKey === "nat" ||
          normalizedKey === "natasha" ||
          normalizedKey === "nat drake" ||
          normalizedKey === "natasha drake"
        ) {

          candidates.push(
            "Nat Drake"
          );

          break;

        }

      }

    }

    const unique =
      [...new Set(candidates)];

    if (
      unique.length === 1
    ) {

      relationships.romanticInterest =
        unique[0];

      return unique[0];

    }

    return "";

  },


  /* ---------------------------------------------------------
     CHARACTER ALIASES
     --------------------------------------------------------- */

  getAliases: function (name) {

    if (
      name === "Nate Drake"
    ) {

      return [
        "Nate Drake",
        "Nate",
        "Nathan Drake",
        "Nathaniel Drake",
        "Nathaniel"
      ];

    }

    if (
      name === "Nat Drake"
    ) {

      return [
        "Nat Drake",
        "Nat",
        "Natasha Drake"
      ];

    }

    const cleanName =
      String(name || "")
        .trim();

    if (!cleanName) {
      return [];
    }

    const aliases = [
      cleanName
    ];

    const parts =
      cleanName
        .split(/\s+/)
        .filter(Boolean);

    /*
      Add first and last name as useful aliases for
      multi-word configured names.
    */

    if (
      parts.length >= 2
    ) {

      aliases.push(
        parts[0]
      );

      aliases.push(
        parts[parts.length - 1]
      );

    }

    return [
      ...new Set(aliases)
    ];

  },


  nameMatches: function (
    text,
    name
  ) {

    const source =
      String(text || "")
        .toLowerCase();

    return this
      .getAliases(name)
      .some(alias => {

        const normalizedAlias =
          String(alias || "")
            .toLowerCase()
            .trim();

        if (!normalizedAlias) {
          return false;
        }

        return source.includes(
          normalizedAlias
        );

      });

  },


  /* ---------------------------------------------------------
     CHARACTER INITIALIZATION
     --------------------------------------------------------- */

  ensureCharacter: function (name) {

    const relationships =
      this.init();

    if (
      !relationships.characters[name]
    ) {

      relationships.characters[name] = {

        friendship: 0,

        romance: 0,

        trust: 50,

        affection: 5,

        attraction: 0,

        comfort: 15,

        jealousy: 0,

        stability: 80,

        history: {

          lastTurn: 0,

          lastEvent: "",

          recentNegative: false,

          recentSupport: false,

          lastSignature: ""

        }

      };

    }

    return relationships.characters[name];

  },


  /* ---------------------------------------------------------
     LEVEL GETTERS
     --------------------------------------------------------- */

  getFriendshipLevel: function (value) {

    if (value <= -61) return "Enemy";
    if (value <= -31) return "Persona Non Grata";
    if (value <= 10) return "Neutral";
    if (value <= 30) return "Acquaintance";
    if (value <= 55) return "Friend";
    if (value <= 80) return "Good Friend";

    return "Best Friends";

  },


  getRomanceLevel: function (value) {

    if (value <= 0) return "No Romantic Interest";
    if (value <= 20) return "Mild Attraction";
    if (value <= 40) return "Romantic Interest";
    if (value <= 65) return "Falling in Love";
    if (value <= 85) return "Sweethearts";

    return "Soulmates";

  },


  getTrustLevel: function (value) {

    if (value >= 80) return "Secure";
    if (value >= 60) return "Trusting";
    if (value >= 40) return "Wary";
    if (value >= 20) return "Jealous";

    return "Possessive";

  },


  getAffectionLevel: function (value) {

    if (value < 20) return "Indifferent";
    if (value < 40) return "Fond";
    if (value < 60) return "Attached";
    if (value < 80) return "Deeply Attached";

    return "Devoted";

  },


  getAttractionLevel: function (value) {

    if (value < 10) return "None";
    if (value < 30) return "Curious";
    if (value < 55) return "Attracted";
    if (value < 80) return "Strongly Attracted";

    return "Intense Attraction";

  },


  getComfortLevel: function (value) {

    if (value < 20) return "Distant";
    if (value < 40) return "Cautious";
    if (value < 60) return "Comfortable";
    if (value < 80) return "Close";

    return "Intimate";

  },


  getJealousyLevel: function (value) {

    if (value < 15) return "Calm";
    if (value < 35) return "Alert";
    if (value < 60) return "Jealous";
    if (value < 80) return "Highly Jealous";

    return "Obsessive";

  },


  getStabilityLevel: function (value) {

    if (value >= 80) return "Stable";
    if (value >= 60) return "Strained";
    if (value >= 40) return "Unstable";
    if (value >= 20) return "Distressed";

    return "Crisis";

  },


