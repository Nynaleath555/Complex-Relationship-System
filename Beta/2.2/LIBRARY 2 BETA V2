    for (let index = 0; index < outputSentences.length; index++) {
      if (inspect(outputSentences[index], outputSentences[index - 1] || "", false)) {
        return true;
      }
    }

    for (let index = 0; index < inputSentences.length; index++) {
      if (inspect(inputSentences[index], inputSentences[index - 1] || "", true)) {
        return true;
      }
    }

