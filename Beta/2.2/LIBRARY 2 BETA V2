/* =========================================================
   COMPLEX REL beta — LIBRARY

   Base behavior:
   - Keep the original relationship stat system.
   - Keep manual stat editing.
   - Keep relationship status card updates.
   - Keep strong romantic reciprocity detection.
   - Keep Inner Self completely independent.
   - Stability is deterministic and uses only the current turn.
   - No Stability markers and no Stability frontMemory injection.DE
   ========================================================= */

const REL = {

  CONFIG_CARD_KEY: "__REL_CONFIG__",
  CONFIG_CARD_TYPE: "REL_CONFIG",
  STATUS_CARD_KEY: "__REL_STATUS__",
  STATUS_CARD_TYPE: "REL_STATUS",
  CONFIG_PLACEHOLDER: "[Write character name here]",
  MANUAL_MARKER: "[REL MANUAL EDIT]",
  CHARACTER_MARKER: "[REL CHARACTER]",

  STAT_LIMITS: {
    friendship: { min: -100, max: 100 },
    romance: { min: -100, max: 100 },
    trust: { min: 0, max: 100 },
    affection: { min: 0, max: 100 },
    attraction: { min: 0, max: 100 },
    comfort: { min: 0, max: 100 },
    jealousy: { min: 0, max: 100 },
    stability: { min: 0, max: 100 }
  },

  init: function () {
    if (!state || typeof state !== "object") {
      throw new Error("Complex REL requires AI Dungeon persistent state.");
    }

    if (!state.relationships || typeof state.relationships !== "object") {
      state.relationships = {};
    }

    const relationships = state.relationships;

    if (!relationships.characters || typeof relationships.characters !== "object") {
      relationships.characters = {};
    }

    if (typeof relationships.romanticInterest !== "string") {
      relationships.romanticInterest = "";
    }

    if (typeof relationships.lastInput !== "string") {
      relationships.lastInput = "";
    }

    if (typeof relationships.lastOutput !== "string") {
      relationships.lastOutput = "";
    }

    if (
      typeof relationships.turn !== "number" ||
      !isFinite(relationships.turn)
    ) {
      relationships.turn = 0;
    }

    if (typeof relationships.skipNextOutputAnalysis !== "boolean") {
      relationships.skipNextOutputAnalysis = false;
    }

    if (typeof relationships.__relSkipNextOutputAnalysis !== "boolean") {
      relationships.__relSkipNextOutputAnalysis = false;
    }

    return relationships;
  },

  clamp: function (value, min, max) {
    const number = Number(value);
    if (!isFinite(number)) return min;
    return Math.max(min, Math.min(max, number));
  },

  round1: function (value) {
    return Math.round(Number(value || 0) * 10) / 10;
  },

  normalizeName: function (name) {
    return String(name || "")
      .trim()
      .replace(/\s+/g, " ");
  },

  escapeRegex: function (value) {
    return String(value || "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  },

  hasAny: function (text, patterns) {
    const source = String(text || "");
    return (patterns || []).some(pattern => pattern.test(source));
  },

  containsWord: function (text, phrase) {
    const source = String(text || "");
    const target = this.normalizeName(phrase);
    if (!source || !target) return false;

    const escaped = this.escapeRegex(target).replace(/\s+/g, "\\s+");

    try {
      return new RegExp(
        "(^|[^\\p{L}\\p{N}_])" +
          escaped +
          "($|[^\\p{L}\\p{N}_])",
        "iu"
      ).test(source);
    } catch (error) {
      return new RegExp(
        "(^|\\W)" + escaped + "($|\\W)",
        "i"
      ).test(source);
    }
  },

  getConfigCard: function () {
    if (!Array.isArray(storyCards)) return null;

    const normalizedKey = String(this.CONFIG_CARD_KEY).toLowerCase();
    const normalizedType = String(this.CONFIG_CARD_TYPE).toLowerCase();

    for (let index = 0; index < storyCards.length; index++) {
      const card = storyCards[index];
      if (!card || typeof card !== "object") continue;

      const keys = String(card.keys || "")
        .split(",")
        .map(value => value.trim().toLowerCase());

      const type = String(card.type || "").toLowerCase();

      if (
        keys.includes(normalizedKey) ||
        type === normalizedType
      ) {
        return {
          card,
          index
        };
      }
    }

    return null;
  },

  buildConfigNotes: function (name, values) {
    const edit = values || {};

    return [
      "Complex REL configuration card.",
      "",
      this.CHARACTER_MARKER,
      name || this.CONFIG_PLACEHOLDER,
      "",
      this.MANUAL_MARKER,
      "Apply: " + (edit.apply ? "yes" : "no"),
      "Friendship: " + (typeof edit.friendship === "undefined" ? "unchanged" : edit.friendship),
      "Romance: " + (typeof edit.romance === "undefined" ? "unchanged" : edit.romance),
      "Trust: " + (typeof edit.trust === "undefined" ? "unchanged" : edit.trust),
      "Affection: " + (typeof edit.affection === "undefined" ? "unchanged" : edit.affection),
      "Attraction: " + (typeof edit.attraction === "undefined" ? "unchanged" : edit.attraction),
      "Comfort: " + (typeof edit.comfort === "undefined" ? "unchanged" : edit.comfort),
      "Jealousy: " + (typeof edit.jealousy === "undefined" ? "unchanged" : edit.jealousy),
      "Stability: " + (typeof edit.stability === "undefined" ? "unchanged" : edit.stability)
    ].join("\n");
  },

  isConfigInstructionLine: function (line) {
    const value = String(line || "").trim();
    const lower = value.toLowerCase();

    if (!value) return true;
    if (value === this.CONFIG_PLACEHOLDER.toLowerCase()) return true;
    if (value.toLowerCase() === this.CONFIG_PLACEHOLDER.toLowerCase()) return true;
    if (value.toLowerCase() === this.MANUAL_MARKER.toLowerCase()) return true;
    if (value.toLowerCase() === this.CHARACTER_MARKER.toLowerCase()) return true;
    if (/^\[.*\]$/.test(value)) return true;
    if (/^apply\s*:/i.test(value)) return true;
    if (/^(friendship|romance|trust|affection|attraction|comfort|jealousy|stability)\s*:/i.test(value)) return true;
    if (lower.includes("complex rel configuration card")) return true;
    if (lower.includes("write the name")) return true;
    if (lower.includes("single romantic interest")) return true;
    if (lower.includes("use a number")) return true;
    if (lower.includes("use unchanged")) return true;
    if (lower.includes("set apply to yes")) return true;

    return false;
  },

  getLegacyConfiguredInterest: function (notes) {
    const lines = String(notes || "")
      .split(/\r?\n/)
      .map(line => line.trim())
      .filter(Boolean);

    for (let index = lines.length - 1; index >= 0; index--) {
      const line = lines[index];
      if (line.toLowerCase() === this.MANUAL_MARKER.toLowerCase()) break;
      if (line.toLowerCase() === this.CHARACTER_MARKER.toLowerCase()) continue;
      if (this.isConfigInstructionLine(line)) continue;
      return line;
    }

    return "";
  },

  getConfiguredInterest: function () {
    const config = this.getConfigCard();
    if (!config || !config.card) return "";

    const notes = String(config.card.description || "");
    const lines = notes
      .split(/\r?\n/)
      .map(line => line.trim());

    let characterMarkerIndex = -1;
    let manualMarkerIndex = lines.length;

    for (let index = 0; index < lines.length; index++) {
      if (lines[index].toLowerCase() === this.CHARACTER_MARKER.toLowerCase()) {
        characterMarkerIndex = index;
      }

      if (lines[index].toLowerCase() === this.MANUAL_MARKER.toLowerCase()) {
        manualMarkerIndex = index;
        break;
      }
    }

    if (characterMarkerIndex >= 0) {
      for (
        let index = characterMarkerIndex + 1;
        index < manualMarkerIndex;
        index++
      ) {
        const line = lines[index];
        if (!line) continue;
        if (line === this.CONFIG_PLACEHOLDER) continue;
        if (this.isConfigInstructionLine(line)) continue;
        return this.normalizeName(line);
      }

      return "";
    }

    return this.normalizeName(
      this.getLegacyConfiguredInterest(notes)
    );
  },

  saveConfigDescription: function (description) {
    const config = this.getConfigCard();
    if (!config || !config.card) return false;

    config.card.description = String(description || "");

    if (typeof updateStoryCard === "function") {
      updateStoryCard(
        config.index,
        String(config.card.keys || this.CONFIG_CARD_KEY),
        String(config.card.entry || ""),
        String(config.card.type || this.CONFIG_CARD_TYPE)
      );
    }

    return true;
  },

  ensureConfigCard: function () {
    const existing = this.getConfigCard();

    if (existing) {
      const notes = String(existing.card.description || "");

      if (!notes.toLowerCase().includes(this.MANUAL_MARKER.toLowerCase())) {
        const configuredName = this.getLegacyConfiguredInterest(notes);
        existing.card.description = this.buildConfigNotes(
          configuredName || "",
          {}
        );

        if (typeof updateStoryCard === "function") {
          updateStoryCard(
            existing.index,
            String(existing.card.keys || this.CONFIG_CARD_KEY),
            String(existing.card.entry || ""),
            String(existing.card.type || this.CONFIG_CARD_TYPE)
          );
        }
      }

      return existing;
    }

    if (typeof addStoryCard !== "function") {
      return null;
    }

    const index = addStoryCard(
      this.CONFIG_CARD_KEY,
      "Complex REL configuration. Configure the romantic interest in Notes.",
      this.CONFIG_CARD_TYPE
    );

    if (
      typeof index !== "number" ||
      index < 0 ||
      !storyCards[index]
    ) {
      return null;
    }

    storyCards[index].description = this.buildConfigNotes("", {});

    if (typeof updateStoryCard === "function") {
      updateStoryCard(
        index,
        this.CONFIG_CARD_KEY,
        String(storyCards[index].entry || ""),
        this.CONFIG_CARD_TYPE
      );
    }

    return {
      card: storyCards[index],
      index
    };
  },

  getAliases: function (name) {
    const cleanName = this.normalizeName(name);
    if (!cleanName) return [];

    const parts = cleanName.split(/\s+/).filter(Boolean);
    const aliases = [cleanName];

    if (parts.length >= 2) {
      aliases.push(parts[0]);
      aliases.push(parts[parts.length - 1]);
    }

    return [...new Set(aliases)];
  },

  nameMatches: function (text, name) {
    return this.getAliases(name).some(alias =>
      this.containsWord(text, alias)
    );
  },

  ensureCharacter: function (name) {
    const relationships = this.init();
    const normalizedName = this.normalizeName(name);

    if (!normalizedName) return null;

    const existingKey = Object.keys(relationships.characters).find(key =>
      this.normalizeName(key).toLowerCase() === normalizedName.toLowerCase()
    );

    const characterName = existingKey || normalizedName;

    if (!relationships.characters[characterName]) {
      relationships.characters[characterName] = {
        friendship: 0,
        romance: 0,
        trust: 50,
        affection: 5,
        attraction: 0,
        comfort: 15,
        jealousy: 0,
        stability: 80,
        history: {
          lastTurn: 0,
          lastEvent: "",
          recentNegative: false,
          recentSupport: false,
          lastSignature: "",
          brainLastLabel: 0
        }
      };
    }

    const character = relationships.characters[characterName];

    if (!character.history || typeof character.history !== "object") {
      character.history = {
        lastTurn: 0,
        lastEvent: "",
        recentNegative: false,
        recentSupport: false,
        lastSignature: "",
        brainLastLabel: 0
      };
    } else if (!Number.isFinite(Number(character.history.brainLastLabel))) {
      character.history.brainLastLabel = 0;
    }

    return character;
  },

  getCharacterName: function (name) {
    const relationships = this.init();
    const normalizedName = this.normalizeName(name);

    if (!normalizedName) return "";

    const existingKey = Object.keys(relationships.characters).find(key =>
      this.normalizeName(key).toLowerCase() === normalizedName.toLowerCase()
    );

    return existingKey || normalizedName;
  },

  getCharacter: function (name) {
    const relationships = this.init();
    const canonicalName = this.getCharacterName(name);

    if (!canonicalName || !relationships.characters[canonicalName]) {
      return null;
    }

    return relationships.characters[canonicalName];
  },

  /* ---------------------------------------------------------
     INNER SELF / BRAIN INTEGRATION
     Brain is the semantic source for relationship signals.
     Regex remains the fallback when no new relationship
     thought is produced or the new thought is not understood.
     --------------------------------------------------------- */

  getBrainCard: function (name) {
    const canonicalName = this.getCharacterName(name);
    if (!canonicalName || !Array.isArray(storyCards)) return null;

    for (const card of storyCards) {
      if (!card || typeof card !== "object") continue;

      const keys = String(card.keys || "");
      if (!keys) continue;

      try {
        const metadata = JSON.parse(keys);
        if (
          metadata &&
          typeof metadata === "object" &&
          !Array.isArray(metadata) &&
          typeof metadata.agent === "string" &&
          this.normalizeName(metadata.agent).toLowerCase() === canonicalName.toLowerCase()
        ) {
          return card;
        }
      } catch (_) {
        // Ignore non-Inner-Self cards.
      }
    }

    return null;
  },

  getBrainThoughts: function (name) {
    const card = this.getBrainCard(name);
    if (!card) {
      return [];
    }

    const description = String(card.description || "");
    if (!description.trim()) return [];

    const thoughts = [];

    // Inner Self may serialize brains as JSON.
    try {
      const parsed = JSON.parse(description);
      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
        for (const [key, value] of Object.entries(parsed)) {
          if (typeof value !== "string") continue;

          const match = value.match(/^\s*(\d+)\s*→\s*([\s\S]*)$/u);
          if (!match) continue;

          thoughts.push({
            key: String(key || "").trim(),
            label: Number(match[1]),
            thought: String(match[2] || "").trim()
          });
        }
      }
    } catch (_) {
      // Fall through to the human-readable format.
    }

    // Inner Self's default human-readable format:
    // key: label → thought
    if (thoughts.length === 0) {
      for (const line of description.split(/\r?\n/)) {
        const clean = line.trim();
        if (!clean) continue;

        const bisector = clean.indexOf(":");
        if (bisector === -1) continue;

        const key = clean.slice(0, bisector).trim();
        const value = clean.slice(bisector + 1).trim();
        const match = value.match(/^(\d+)\s*→\s*([\s\S]*)$/u);

        if (!match) continue;

        thoughts.push({
          key,
          label: Number(match[1]),
          thought: String(match[2] || "").trim()
        });
      }
    }

    thoughts.sort((a, b) => a.label - b.label);
    return thoughts;
  },

  getBrainMaxLabel: function (name) {
    const thoughts = this.getBrainThoughts(name);
    let max = 0;

    for (const item of thoughts) {
      if (Number.isInteger(item.label) && item.label > max) {
        max = item.label;
      }
    }

    return max;
  },

  primeBrainTracking: function (name) {
    const character = this.ensureCharacter(name);
    if (!character) return 0;

    if (!character.history || typeof character.history !== "object") {
      character.history = {};
    }

    const currentMax = this.getBrainMaxLabel(name);
    const previous = Number(character.history.brainLastLabel);

    if (!Number.isFinite(previous)) {
      character.history.brainLastLabel = currentMax;
    } else if (currentMax > previous) {
      // A context hook can see changes made before REL gets here.
      // Never treat already-existing thoughts as a fresh event.
      character.history.brainLastLabel = currentMax;
    }

    return Number(character.history.brainLastLabel || 0);
  },

  markBrainCurrent: function (name) {
    const character = this.ensureCharacter(name);
    if (!character) return 0;

    const currentMax = this.getBrainMaxLabel(name);
    character.history.brainLastLabel = currentMax;
    return currentMax;
  },

    detectBrainSignals: function (name) {
    const character = this.ensureCharacter(name);

    if (!character) {
      return {
        detected: false,
        hasFreshRelationshipThought: false,
        signals: {},
        thoughts: []
      };
    }

    if (!character.history || typeof character.history !== "object") {
      character.history = {};
    }

    const previousLabel = Number.isFinite(Number(character.history.brainLastLabel))
      ? Number(character.history.brainLastLabel)
      : 0;

    const thoughts = this.getBrainThoughts(name);
    const fresh = thoughts.filter(item => item.label > previousLabel);

    if (fresh.length === 0) {
      return {
        detected: false,
        hasFreshRelationshipThought: false,
        signals: {},
        thoughts: []
      };
    }

    character.history.brainLastLabel = Math.max(
      previousLabel,
      ...fresh.map(item => item.label)
    );

        const signals = {
      spentTime: false,
      sharedActivity: false,
      trivialConversation: false,
      joking: false,
      caredFor: false,
      intimateSharing: false,
      transparent: false,
      support: false,
      neglect: false,
      betrayal: false,
      argument: false,
      seriousHurt: false,
      flirting: false,
      romanticPhysical: false,

      romanticReciprocity: false,
      romanticInitiation: false,
      romanticAcceptance: false,
      romanticAffection: false,
      romanticCloseness: false,
      romanticVerbalReciprocity: false,
      romanticVulnerability: false,
      romanticCommitment: false,
      intimateReciprocity: false,

      romanticRefusal: false,

      rivalInteraction: false,
      secrecyAboutOthers: false
    };

    const mark = (key, patterns, source) => {
      if ((patterns || []).some(pattern => pattern.test(source))) {
        signals[key] = true;
      }
    };

    const aliases = this.getAliases(name);

    const relationshipThoughts = fresh.filter(item => {
      const source =
        String(item.key || "") +
        " " +
        String(item.thought || "");

      if (
        aliases.some(alias =>
          this.containsWord(source, alias)
        )
      ) {
        return true;
      }

      return /\b(?:you|your|we|us|together|between us|our)\b/i.test(source) &&
        /\b(?:kiss|kissed|kissing|touch|touched|touching|hug|hugged|hugging|embrace|embraced|cuddle|cuddled|caress|caressed|flirt|flirting|tease|teasing|love|romance|romantic|intimate|affection|attraction|jealous|jealousy|care|cared|support|supported|confide|confided|open(?:ed)?\s+up|feelings?|desire|want(?:ed)?|close|closer)\b/i.test(source);
    });

    const allFreshText = relationshipThoughts
      .map(item =>
        `${item.key || ""}: ${item.thought || ""}`
      )
      .join("\n");

    /*
     * A fresh relationship thought is authoritative.
     * Regex must not be mixed with Brain signals on the same turn.
     */

    for (const item of relationshipThoughts) {
      const source =
        String(item.key || "").toLowerCase() +
        " " +
        String(item.thought || "");

      mark("spentTime", [
        /\b(?:spend|spent|spending|hang(?:ed|ing)?\s+out|visit(?:ed|ing)?|joined|stay(?:ed|ing)?)\b[\s\S]{0,100}\b(?:together|with|alone)\b/i,
        /\b(?:time|evening|afternoon|night|morning)\b[\s\S]{0,70}\b(?:together|with|alone)\b/i
      ], source);

      mark("sharedActivity", [
        /\b(?:played?|play(?:ing)?|practiced?|practice|watched?|watch(?:ing)?|cooked?|cook(?:ing)?|trained?|train(?:ing)?|worked?|work(?:ing)?|studied?|study(?:ing)?)\b[\s\S]{0,100}\b(?:with|together)\b/i,
        /\b(?:we|us)\b[\s\S]{0,60}\b(?:played?|watched?|cooked?|practiced?|trained?|worked?|studied?)\b/i
      ], source);

      mark("trivialConversation", [
        /\b(?:talk(?:ed|ing)?|chat(?:ted|ting)?|conversation|conversed?|small\s+talk)\b[\s\S]{0,100}\b(?:with|together)\b/i,
        /\b(?:we|us)\b[\s\S]{0,60}\b(?:talked|chatted|joked|bantered)\b/i
      ], source);

      mark("joking", [
        /\b(?:joke(?:d|s|ing)?|tease(?:d|s|ing)?|banter(?:ed|ing)?|laugh(?:ed|ing)?|made me laugh|had fun|playful(?:ly)?)\b/i
      ], source);

      mark("caredFor", [
        /\b(?:care(?:d|s|ing)?|cared about|worry(?:ied|ies|ing) about|look(?:ed|s)?\s+after|take(?:s|ing)?\s+care|took\s+care|help(?:ed|s|ing)?|comfort(?:ed|s|ing)?|checked\s+on|protect(?:ed|s|ing)?)\b/i,
        /\b(?:feel|felt|feeling)\b[\s\S]{0,70}\b(?:safe|cared\s+for|looked\s+after|protected)\b/i
      ], source);

      mark("support", [
        /\b(?:support(?:ed|s|ing)?|encourag(?:ed|es|ing)|reassur(?:ed|es|ing)|stood\s+by|was\s+there\s+for|be\s+there\s+for|had\s+my\s+back|backed\s+me\s+up)\b/i
      ], source);

      mark("intimateSharing", [
        /\b(?:opened\s+up|open(?:ed|s)?\s+up|confide(?:d|s|ing)?|shared?\s+(?:a\s+)?(?:secret|private|personal|deep)|revealed?\s+(?:a\s+)?(?:secret|fear|feeling)|vulnerable|vulnerability)\b/i,
        /\b(?:private|alone|quiet|close|closer|intimate)\b[\s\S]{0,100}\b(?:whisper(?:ed|s|ing)?|shared?|confided?|opened?\s+up|revealed?|admitted?)\b/i,
        /\b(?:forehead|temple)\b[\s\S]{0,50}\b(?:against|to|touch(?:es|ed|ing)?|rest(?:s|ed|ing)?)\b/i
      ], source);

      mark("transparent", [
        /\b(?:was|am|being)\s+(?:honest|truthful)\b/i,
        /\b(?:came\s+clean|told\s+the\s+truth|admitted|admit|confessed|confess)\b/i
      ], source);

      mark("neglect", [
        /\b(?:ignored?|ignoring|neglected?|neglecting|forgot|forgetting|left\s+me\s+waiting|stood\s+me\s+up|let\s+me\s+down)\b/i,
        /\b(?:feel|felt|feeling)\b[\s\S]{0,60}\b(?:ignored|neglected|forgotten|abandoned)\b/i
      ], source);

      mark("betrayal", [
        /\b(?:betray(?:ed|s|ing|al)?|backstab(?:bed|s|bing)?|lied\s+to\s+me|lie\s+to\s+me|cheat(?:ed|s|ing)?)\b/i
      ], source);

      mark("argument", [
        /\b(?:argue(?:d|s|ing)?|argument|fight(?:ing|s)?|fought|confront(?:ed|s|ing)?|shout(?:ed|s|ing)?|yell(?:ed|s|ing)?|scream(?:ed|s|ing)?)\b/i
      ], source);

      mark("seriousHurt", [
        /\b(?:deeply|seriously|badly)\s+hurt\b/i,
        /\b(?:humiliated|devastated|heartbroken|crushed|wounded|destroyed)\b/i
      ], source);

      mark("flirting", [
        /\b(?:flirt(?:ed|s|ing)?|seduc(?:e|ed|es|ing)|wink(?:ed|s|ing)?\s+at)\b/i,
        /\b(?:playful(?:ly)?|mischievous(?:ly)?|provocative(?:ly)?|smirk(?:s|ed|ing)?|raises?\s+(?:an?\s+)?eyebrow)\b[\s\S]{0,90}\b(?:gaze|look|eyes?|smile|close|closer|touch|kiss|voice|tease)\b/i,
        /\b(?:holds?|held|locks?)\s+(?:my\s+|your\s+)?(?:gaze|eyes?|eye\s+contact)\b[\s\S]{0,90}\b(?:close|closer|touch|kiss|tease|smile|leans?)\b/i,
        /\b(?:voice|tone)\b[\s\S]{0,40}\b(?:lowers?|lowered|drops?|dropped|husk(?:y|ily)|softens?|softened)\b[\s\S]{0,80}\b(?:close|closer|whisper|touch|kiss|tease)\b/i
      ], source);

      mark("romanticPhysical", [
        /\b(?:kiss(?:ed|es|ing)?|cuddle(?:d|s|ing)?|hug(?:ged|s|ging)?|embrace(?:d|s|ing)?|caress(?:ed|es|ing)?|hold\s+hands?|held\s+hands?)\b/i,
        /\b(?:wanted|want|wished|wish|longed)\s+to\s+(?:kiss|touch|hold|cuddle|hug)\b/i,
        /\b(?:leans?|leaned|leaning)\s+in(?:\s+closer)?\b/i,
        /\b(?:moves?|moved|moving|draws?|drew|drawing)\s+(?:closer|close)\b/i,
        /\b(?:closes?|closed|closing)\s+(?:the\s+)?distance\b/i,
        /\b(?:pulls?|pulled|draws?|drew)\s+(?:you|them|him|her)\s+(?:closer|close|against)\b/i,
        /\b(?:holds?|held|keeps?|kept)\s+(?:you|them|him|her)\s+close\b/i,
        /\b(?:their|his|her)\s+lips?\s+(?:meet|met|brush|brushed|press|pressed|touch|touched)\b/i,
        /\b(?:hands?|fingers?)\b[\s\S]{0,70}\b(?:waist|hip|back|neck|nape|cheek|face|hair|thigh)\b/i
      ], source);

      /*
       * Refusal is deliberately strict.
       * Hesitation, uncertainty, thought, pauses, "maybe", etc. are NOT refusals.
       */
      mark("romanticRefusal", [
        /\b(?:refuses?|refused|rejects?|rejected|says?\s+no|said\s+no|tells?\s+you\s+no|told\s+you\s+no|not\s+interested)\b[\s\S]{0,100}\b(?:kiss|touch|hug|embrace|cuddle|flirt|date|romance|advance|relationship)\b/i,
        /\b(?:pulls?|pulled|turns?|turned|backs?|backed|steps?|stepped)\s+away\b[\s\S]{0,90}\b(?:kiss|touch|hug|embrace|cuddle|flirt|romance|advance|close|closer)\b/i,
        /\b(?:breaks?|broke|ends?|ended|stops?|stopped)\s+(?:the\s+)?(?:kiss|embrace|hug|cuddle|touch|flirting)\b/i,
        /\b(?:pushes?|pushed)\s+(?:you|them|him|her)\s+away\b[\s\S]{0,70}\b(?:kiss|touch|embrace|hug|cuddle|romance|advance)\b/i
      ], source);

      /*
       * Positive reciprocity:
       * direct return, mutuality, continuation and active participation.
       */
      mark("romanticReciprocity", [
        /\b(?:kiss(?:es|ed|ing)?|hug(?:s|ged|ging)?|embrace(?:s|d|ing)?|cuddle(?:s|d|ing)?|touch(?:es|ed|ing)?)\b[\s\S]{0,120}\b(?:back|again|too|in\s+return|each\s+other|one\s+another|mutual(?:ly)?|together)\b/i,
        /\b(?:returns?|returned|accepts?|accepted|welcomes?|welcomed|mirrors?|mirrored|matches?|matched)\b[\s\S]{0,100}\b(?:kiss|touch|hug|embrace|cuddle|flirt|gesture|affection)\b/i,
        /\b(?:mutual(?:ly)?|each\s+other|one\s+another|together|both|in\s+sync|mirroring)\b[\s\S]{0,100}\b(?:kiss|touch|hug|embrace|cuddle|flirt|caress|close)\b/i,
        /\b(?:doesn't|does\s+not|didn't|did\s+not)\s+(?:pull\s+away|push\s+away|resist|stop|break|move\s+away)\b[\s\S]{0,80}\b(?:kiss|touch|hug|embrace|cuddle|close|together)\b/i,
        /\b(?:continues?|continued|keeps?|kept|deepens?|deepened|lingers?|lingered|stays?|stayed|remains?|remained)\b[\s\S]{0,90}\b(?:the\s+kiss|kissing|touching|embracing|hugging|cuddling|close|closer|together|against)\b/i,
        /\b(?:leans?|leaned)\s+in(?:\s+closer)?\b[\s\S]{0,80}\b(?:kiss(?:es|ed|ing)?|touch(?:es|ed|ing)?|embrace(?:s|d|ing)?|hug(?:s|ged|ging)?|cuddle(?:s|d|ing)?)\b/i,
        /\b(?:presses?|pressed|brushes?|brushed|touches?|touched)\s+(?:their|his|her)\s+lips?\s+(?:against|to)\s+yours\b/i,
        /\b(?:meets?|met)\s+your\s+(?:lips|mouth)\b/i,
        /\b(?:pulls?|pulled|draws?|drew)\s+you\s+(?:closer|close|against)\b/i
      ], source);

      mark("rivalInteraction", [
        /\b(?:jealous|jealousy|insecure|threatened)\b[\s\S]{0,120}\b(?:someone\s+else|another|other|rival|ex|stranger)\b/i,
        /\b(?:flirt(?:ed|s|ing)?|kiss(?:ed|es|ing)?|date(?:d|s|ing)?|romance(?:d|s|ing)?|dance(?:d|s|ing)?)\b[\s\S]{0,100}\b(?:someone\s+else|another|other|rival|ex|stranger)\b/i
      ], source);

      mark("secrecyAboutOthers", [
        /\b(?:hid|hide|hiding|kept|keep|secret|secrecy)\b[\s\S]{0,110}\b(?:someone\s+else|another|other|rival|ex)\b/i,
        /\b(?:someone\s+else|another|other|rival|ex)\b[\s\S]{0,90}\b(?:secret|hide|hiding|hidden)\b/i
      ], source);
    }

    /*
     * Do not let speculative wording erase a concrete realized action.
     */
    const hasRealizedAction =
      relationshipThoughts.some(item =>
        /\b(?:kiss(?:ed|es|ing)?|touch(?:ed|es|ing)?|hug(?:ged|s|ging)?|embrace(?:d|s|ing)?|cuddle(?:d|s|ing)?|caress(?:ed|s|ing)?|flirt(?:ed|s|ing)?|tease(?:d|s|ing)?|leans?\s+in|moved?\s+closer|pulled?\s+closer|returned?|accepted?|deepened?|continued?|lingered?)\b/i.test(
          String(item.thought || "")
        )
      );

    if (
      /\b(?:maybe|might|could|should|would|perhaps|if)\b/i.test(allFreshText) &&
      !hasRealizedAction
    ) {
      for (const key of Object.keys(signals)) {
        if (key !== "romanticReciprocity") {
          signals[key] = false;
        }
      }
    }

    const detected = Object.values(signals).some(Boolean);

    return {
      detected,
      hasFreshRelationshipThought: relationshipThoughts.length > 0,
      signals,
      thoughts: relationshipThoughts
    };
  },

  detectInterest: function () {
    const relationships = this.init();
    const configuredName = this.getConfiguredInterest();

    relationships.romanticInterest = configuredName || "";
    return configuredName || "";
  },

