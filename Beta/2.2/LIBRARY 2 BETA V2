  /* ---------------------------------------------------------
     ROMANTIC RECIPROCITY
     --------------------------------------------------------- */

    /* ---------------------------------------------------------
     ROMANTIC SIGNALS

     Positive romance is intentionally broad:
     - Active reciprocity
     - NPC romantic initiation
     - Romantic acceptance
     - Affectionate behavior
     - Romantic closeness
     - Verbal emotional reciprocity
     - Romantic vulnerability
     - Romantic commitment
     - Intimate reciprocity

     Refusal is intentionally narrow:
     only explicit, unmistakable rejection counts.

     Ambiguity such as hesitation, internal conflict,
     "I shouldn't", "I almost...", breathing pauses,
     temporary distance, etc. does NOT count as refusal.
     --------------------------------------------------------- */

  detectRomanticSignals: function (name, input, output, brainMode) {
    const source = this.normalizeInteractionText(output);
    const playerInput = this.normalizeInteractionText(input);
    const isBrainMode = Boolean(brainMode);

    const result = {
      romanticReciprocity: false,
      romanticInitiation: false,
      romanticAcceptance: false,
      romanticAffection: false,
      romanticCloseness: false,
      romanticVerbalReciprocity: false,
      romanticVulnerability: false,
      romanticCommitment: false,
      intimateReciprocity: false,
      romanticRefusal: false
    };

    if (!source) return result;

    const aliases = this.getAliases(name);

    const escapedAliases = aliases.map(alias =>
      this.escapeRegex(alias)
    );

    const aliasRegex = escapedAliases.length
      ? new RegExp(
          "\\b(?:" + escapedAliases.join("|") + ")\\b",
          "i"
        )
      : null;

    /*
     * In normal output there must be some reference to the NPC
     * somewhere in the response.
     *
     * We intentionally do NOT require the name to appear in the
     * same sentence as the action. AI Dungeon commonly writes:
     *
     * "His mouth crashes against yours..."
     *
     * and only mentions "Mateo" several sentences later.
     */
    if (
      !isBrainMode &&
      (!aliasRegex || !aliasRegex.test(source))
    ) {
      return result;
    }

    const sentences = this.splitInteractionSentences(source);

    /*
     * What did the player actually initiate?
     *
     * "intimate" is deliberately separated from romantic categories.
     * Purely sexual participation should affect attraction/affection
     * without automatically becoming romantic reciprocity.
     */
    const inputPatterns = {
      kiss:
        /\b(?:kiss|kisses|kissed|kissing|make\s+out|making\s+out)\b/i,

      flirt:
        /\b(?:flirt|flirts|flirted|flirting|flirty|seduce|seductive|seductively)\b/i,

      date:
        /\b(?:date|dating|go\s+out\s+with\s+me|ask(?:ed)?\s+(?:him|her|them|you)?\s*out|take\s+(?:him|her|them|you)\s+out|romantic\s+outing|dinner\s+date)\b/i,

      touch:
        /\b(?:touch|touches|touched|touching|stroke|strokes|stroked|stroking|hold(?:s|ing)?\s+(?:hands?|his|her|their|your)|hug(?:s|ged|ging)?|embrace(?:s|d|ing)?|cuddle(?:s|d|ing)?|caress(?:es|ed|ing)?)\b/i,

      gift:
        /\b(?:romantic\s+gift|romantic\s+present|love\s+letter|roses?|bouquet|jewelry|necklace|bracelet|valentine(?:'s)?\s+gift)\b/i,

      words:
        /\b(?:i\s+love\s+you|love\s+you|my\s+feelings\s+for\s+you|confess(?:\s+my)?\s+feelings|romantic\s+feelings|want\s+to\s+be\s+with\s+you|tell\s+[^.!?]{0,40}\s+you\s+(?:that\s+)?i\s+(?:love|adore))\b/i,

      time:
        /\b(?:romantic\s+date|romantic\s+outing|romantic\s+evening|spend\s+time\s+alone|spend\s+the\s+evening\s+alone|just\s+the\s+two\s+of\s+us|one[-\s]on[-\s]one|private\s+evening|alone\s+together)\b/i,

      intimate:
        /\b(?:sensual|sensually|intimate|intimacy|erotic|erotically|seductive|seductively|press\s+(?:against|closer)|move\s+(?:against|closer)|grind|straddle|undress|undresses|undressed|naked|bare\s+skin)\b/i
    };

    const candidateCategories = Object.keys(inputPatterns)
      .filter(category =>
        inputPatterns[category].test(playerInput)
      );

    const romanticInitiative =
      isBrainMode ||
      candidateCategories.some(category =>
        [
          "kiss",
          "flirt",
          "date",
          "touch",
          "gift",
          "words",
          "time"
        ].includes(category)
      );

    const romanticOrIntimateInitiative =
      isBrainMode ||
      romanticInitiative ||
      candidateCategories.includes("intimate");

    const hasIntimateInitiative =
      isBrainMode ||
      candidateCategories.includes("intimate");

    /*
     * These are actual realized actions.
     *
     * "almost", "nearly", "considers", "thinks about", etc.
     * are excluded because they describe intention rather than
     * something that actually happened.
     */
    const speculativeActionPattern =
      /\b(?:almost|nearly|considers?|considered|thinks?\s+about|thought\s+about|tries?\s+to|tried\s+to|attempts?\s+to|attempted\s+to|plans?\s+to|planned\s+to|intends?\s+to|intended\s+to|wants?\s+to|wanted\s+to|hopes?\s+to|hoped\s+to)\b/i;

    /*
     * Only clearly retrospective language invalidates a current
     * romantic action. We deliberately do NOT use the old bare
     * "before" / "earlier" style broad filter here because AI
     * often writes:
     *
     * "Before kissing you, he..."
     *
     * which is still a current action.
     */
    const retrospectivePattern =
      /\b(?:yesterday|last\s+(?:night|day|week|month|year)|earlier|previously|in\s+the\s+past|used\s+to|once\s+before|remember(?:s|ed)?|recall(?:s|ed)?|recalled)\b/i;

    const realizedMatch = (sentence, pattern) => {
      if (!sentence) return null;
      if (retrospectivePattern.test(sentence)) return null;

      const match = sentence.match(pattern);
      if (!match) return null;

      const beforeAction = sentence.slice(
        Math.max(0, match.index - 90),
        match.index
      );

      if (speculativeActionPattern.test(beforeAction)) {
        return null;
      }

      return match;
    };

    const anySentenceMatches = (
      patterns,
      requireRomanticContext
    ) => {
      if (
        requireRomanticContext &&
        !romanticInitiative &&
        !isBrainMode
      ) {
        return false;
      }

      return sentences.some(sentence =>
        (patterns || []).some(pattern =>
          Boolean(realizedMatch(sentence, pattern))
        )
      );
    };

    /*
     * ---------------------------------------------------------
     * STRONG RECIPROCITY
     * ---------------------------------------------------------
     *
     * These are responses to an action already initiated by the
     * player. We intentionally include narrative-style wording,
     * not only literal "kisses you back".
     */
    const reciprocalPatterns = {
      kiss: [
        /\b(?:kisses?|kissed)\s+(?:you|me)(?:\s+(?:back|again))?\b/i,
        /\breturns?\s+(?:your\s+|the\s+)?kiss\b/i,
        /\bdeepens?\s+(?:the\s+)?kiss\b/i,
        /\bresponds?\s+(?:by\s+|with\s+)?kissing\s+(?:you|me)\b/i,
        /\bpresses?\s+(?:their|his|her)\s+lips\s+(?:against|to)\s+yours\b/i,
        /\bmeets?\s+your\s+(?:lips|mouth)\b/i,
        /\bbrushes?\s+(?:their|his|her)\s+lips\s+against\s+yours\b/i,
        /\btouches?\s+(?:their|his|her)\s+lips\s+to\s+yours\b/i,
        /\bseeks?\s+your\s+lips\b/i,
        /\bcaptures?\s+your\s+lips\b/i,
        /\bpulls?\s+you\s+(?:into|closer\s+for)\s+(?:the\s+)?kiss\b/i,
        /\bkeeps?\s+kissing\s+(?:you|me)\b/i,
        /\bcontinues?\s+kissing\s+(?:you|me)\b/i,
        /\bdoesn['’]?t\s+let\s+the\s+kiss\s+end\b/i,
        /\bcannot\s+resist\s+kissing\s+(?:you|me)\b/i,
        /\bcan['’]?t\s+resist\s+kissing\s+(?:you|me)\b/i,
        /\bcouldn['’]?t\s+resist\s+kissing\s+(?:you|me)\b/i,
        /\bgives?\s+in\s+and\s+kisses?\s+(?:you|me)\b/i,
        /\b(?:his|her|their)\s+mouth\s+(?:crashes|presses|meets|moves)\s+(?:against|onto|to)\s+yours\b/i,
        /\b(?:his|her|their)\s+lips?\s+(?:crash|press|move|meet)\s+(?:against|with)\s+yours\b/i
      ],

      flirt: [
        /\bflirts?\s+back\b/i,
        /\breciprocates?\s+(?:your\s+)?flirting\b/i,
        /\breturns?\s+(?:the\s+)?flirtation\b/i,
        /\bteases?\s+you\s+(?:playfully|flirtatiously)\b/i,
        /\bflirtatiously\s+teases?\s+you\b/i,
        /\bmatches?\s+your\s+flirt(?:ing)?\b/i
      ],

      date: [
        /\bagrees?\s+to\s+(?:go\s+on\s+)?(?:a\s+)?date\s+with\s+you\b/i,
        /\baccepts?\s+(?:your\s+)?(?:date\s+)?invitation\b/i,
        /\basks?\s+you\s+out\b/i,
        /\binvites?\s+you\s+(?:out|on\s+(?:a\s+)?date)\b/i,
        /\bsuggests?\s+(?:a\s+)?date\s+with\s+you\b/i,
        /\bproposes?\s+(?:a\s+)?date\b/i,
        /\bplans?\s+(?:a\s+)?date\s+with\s+you\b/i
      ],

      touch: [
        /\bhugs?\s+you\s+back\b/i,
        /\breturns?\s+(?:your\s+)?hug\b/i,
        /\bembraces?\s+you\b/i,
        /\bcuddles?\s+(?:closer|with\s+you)\b/i,
        /\bpulls?\s+you\s+(?:closer|into\s+(?:their|his|her)\s+(?:arms|embrace))\b/i,
        /\btakes?\s+your\s+hand\b/i,
        /\bholds?\s+your\s+hand\b/i,
        /\bsqueezes?\s+your\s+hand\b/i,
        /\blaces?\s+(?:their|his|her)\s+fingers\s+with\s+yours\b/i,
        /\bleans?\s+into\s+your\s+touch\b/i,
        /\breturns?\s+your\s+touch\b/i,
        /\bresponds?\s+to\s+your\s+touch\b/i,
        /\bmirrors?\s+your\s+touch\b/i,
        /\bmoves?\s+closer\s+to\s+you\b/i
      ],

      gift: [
        /\breturns?\s+the\s+(?:romantic\s+)?gesture\b/i,
        /\bgives?\s+you\s+(?:a\s+)?romantic\s+gift\b/i,
        /\bgives?\s+you\s+flowers?\b/i,
        /\bgives?\s+you\s+roses?\b/i,
        /\bgives?\s+you\s+jewelry\b/i,
        /\breturns?\s+the\s+gift\b/i
      ],

      words: [
        /\bsays?\s+(?:they\s+)?love\s+you\s+too\b/i,
        /\btells?\s+you\s+(?:they\s+)?love\s+you\b/i,
        /\badmits?\s+(?:their\s+)?feelings\s+for\s+you\b/i,
        /\bconfesses?\s+(?:their\s+)?feelings\b/i,
        /\bsays?\s+they\s+have\s+feelings\s+for\s+you\b/i,
        /\bsays?\s+they\s+want\s+to\s+be\s+with\s+you\b/i,
        /\breturns?\s+your\s+confession\b/i,
        /\breciprocates?\s+your\s+feelings\b/i,
        /\bsays?\s+they\s+feel\s+the\s+same\s+way\b/i
      ],

      time: [
        /\bagrees?\s+to\s+spend\s+(?:more\s+)?time\s+with\s+you\b/i,
        /\basks?\s+you\s+to\s+stay\b/i,
        /\bsuggests?\s+spending\s+(?:more\s+)?time\s+(?:together|with\s+you)\b/i,
        /\bwants?\s+you\s+to\s+stay\s+with\s+(?:them|him|her)\b/i,
        /\bsuggests?\s+being\s+alone\s+with\s+you\b/i,
        /\basks?\s+to\s+spend\s+time\s+alone\s+with\s+you\b/i,
        /\bsuggests?\s+(?:just\s+the\s+two\s+of\s+you|a\s+private\s+evening\s+together)\b/i
      ]
    };

    if (romanticInitiative) {
      for (const category of [
        "kiss",
        "flirt",
        "date",
        "touch",
        "gift",
        "words",
        "time"
      ]) {
        if (
          !isBrainMode &&
          !candidateCategories.includes(category)
        ) {
          continue;
        }

        if (
          anySentenceMatches(
            reciprocalPatterns[category],
            true
          )
        ) {
          result.romanticReciprocity = true;
          break;
        }
      }
    }

    /*
     * ---------------------------------------------------------
     * NPC ROMANTIC INITIATION
     * ---------------------------------------------------------
     *
     * Deliberately only explicit initiative.
     * This prevents a normal "leans in" response from being counted
     * both as reciprocity and initiation.
     */
    const initiationPatterns = [
      /\bkisses?\s+(?:you|me)\s+first\b/i,
      /\binitiates?\s+(?:a\s+)?kiss\b/i,
      /\bmakes?\s+the\s+first\s+move\b/i,
      /\basks?\s+you\s+out\b/i,
      /\binvites?\s+you\s+on\s+(?:a\s+)?date\b/i,
      /\breaches?\s+for\s+your\s+hand\b/i,
      /\btakes?\s+your\s+hand\s+first\b/i,
      /\bsuddenly\s+kisses?\s+(?:you|me)\b/i
    ];

    result.romanticInitiation =
      anySentenceMatches(
        initiationPatterns,
        false
      );

    /*
     * ---------------------------------------------------------
     * ROMANTIC ACCEPTANCE
     * ---------------------------------------------------------
     *
     * Mainly date/private-evening/gift acceptance.
     * Love confessions are handled by verbal reciprocity.
     */
    const acceptancePatterns = [
      /\bagrees?\s+to\s+(?:go\s+on\s+)?(?:a\s+)?date\s+with\s+you\b/i,
      /\baccepts?\s+(?:your\s+)?(?:date\s+)?invitation\b/i,
      /\bsays?\s+(?:yes|i['’]?d\s+love\s+to)\b/i,
      /\bthat\s+sounds?\s+(?:nice|good|wonderful)\b/i,
      /\bagrees?\s+to\s+spend\s+(?:the\s+)?(?:evening|night|time)\s+alone\s+with\s+you\b/i,
      /\baccepts?\s+your\s+(?:romantic\s+)?proposal\b/i,
      /\baccepts?\s+your\s+romantic\s+gift\b/i
    ];

    if (
      isBrainMode ||
      candidateCategories.some(category =>
        ["date", "time", "gift"].includes(category)
      )
    ) {
      result.romanticAcceptance =
        anySentenceMatches(
          acceptancePatterns,
          false
        );
    }

    /*
     * ---------------------------------------------------------
     * ROMANTIC AFFECTION
     * ---------------------------------------------------------
     */
    const affectionPatterns = [
      /\bcaresses?\s+your\s+(?:cheek|face|hair|neck|hand)\b/i,
      /\bstrokes?\s+your\s+(?:cheek|hair|face|arm|back)\b/i,
      /\bbrushes?\s+(?:your\s+)?hair\s+(?:back|away)\s+from\s+your\s+face\b/i,
