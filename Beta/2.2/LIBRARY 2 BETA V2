      String(sentence || "")
    );
  },

  hasActiveRelationshipAction: function (name, input, output, patterns, options) {
    const opts = options || {};
    const canonicalName = this.getCharacterName(name);
    const aliases = this.getAliases(canonicalName);
    const aliasRegex = aliases.length
      ? new RegExp(
          "\\b(?:" + aliases.map(alias => this.escapeRegex(alias)).join("|") + ")\\b",
          "i"
        )
      : null;

    const inputSentences = this.splitInteractionSentences(
      this.normalizeInteractionText(input)
    );
    const outputSentences = this.splitInteractionSentences(
      this.normalizeInteractionText(output)
    );

    const inspect = (sentence, previousSentence, fromInput) => {
      if (!sentence) return false;
      if (this.isRetrospectiveRelationshipSentence(sentence)) return false;

      if (opts.directiveOnly && !fromInput) return false;
      if (opts.inputOnly && !fromInput) return false;

      const hasName = aliasRegex ? aliasRegex.test(sentence) : false;
      const hasPreviousName = aliasRegex && previousSentence
        ? aliasRegex.test(previousSentence)
        : false;

      if (!opts.allowUnbound && !hasName && !hasPreviousName) {
        // Player-input actions can be direct even when the NPC name is omitted
        // because "you" is the player-facing target in those commands.
        if (!fromInput || !this.isInputDirective(sentence)) return false;
      }

      if (opts.negationPattern && opts.negationPattern.test(sentence)) {
        return false;
      }

      return (patterns || []).some(pattern => pattern.test(sentence));
