/* =========================================================
   COMPLEX REL BETA — LIBRARY

   Base behavior:
   - Keep the original relationship stat system.
   - Keep manual stat editing.
   - Keep relationship status card updates.
   - Keep strong romantic reciprocity detection.
   - Keep Inner Self completely independent.
   - Stability is deterministic and uses only the current turn.
   - No Stability markers and no Stability frontMemory injection.
   ========================================================= */

const REL = {

  CONFIG_CARD_KEY: "__REL_CONFIG__",
  CONFIG_CARD_TYPE: "REL_CONFIG",
  STATUS_CARD_KEY: "__REL_STATUS__",
  STATUS_CARD_TYPE: "REL_STATUS",
  CONFIG_PLACEHOLDER: "[Write character name here]",
  MANUAL_MARKER: "[REL MANUAL EDIT]",
  CHARACTER_MARKER: "[REL CHARACTER]",

  STAT_LIMITS: {
    friendship: { min: -100, max: 100 },
    romance: { min: -100, max: 100 },
    trust: { min: 0, max: 100 },
    affection: { min: 0, max: 100 },
    attraction: { min: 0, max: 100 },
    comfort: { min: 0, max: 100 },
    jealousy: { min: 0, max: 100 },
    stability: { min: 0, max: 100 }
  },

  init: function () {
    if (!state || typeof state !== "object") {
      throw new Error("Complex REL requires AI Dungeon persistent state.");
    }

    if (!state.relationships || typeof state.relationships !== "object") {
      state.relationships = {};
    }

    const relationships = state.relationships;

    if (!relationships.characters || typeof relationships.characters !== "object") {
      relationships.characters = {};
    }

    if (typeof relationships.romanticInterest !== "string") {
      relationships.romanticInterest = "";
    }

    if (typeof relationships.lastInput !== "string") {
      relationships.lastInput = "";
    }

    if (typeof relationships.lastOutput !== "string") {
      relationships.lastOutput = "";
    }

    if (
      typeof relationships.turn !== "number" ||
      !isFinite(relationships.turn)
    ) {
      relationships.turn = 0;
    }

    if (typeof relationships.skipNextOutputAnalysis !== "boolean") {
      relationships.skipNextOutputAnalysis = false;
    }

    if (typeof relationships.__relSkipNextOutputAnalysis !== "boolean") {
      relationships.__relSkipNextOutputAnalysis = false;
    }

    return relationships;
  },

  clamp: function (value, min, max) {
    const number = Number(value);
    if (!isFinite(number)) return min;
    return Math.max(min, Math.min(max, number));
  },

  round1: function (value) {
    return Math.round(Number(value || 0) * 10) / 10;
  },

  normalizeName: function (name) {
    return String(name || "")
      .trim()
      .replace(/\s+/g, " ");
  },

  escapeRegex: function (value) {
    return String(value || "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  },

  hasAny: function (text, patterns) {
    const source = String(text || "");
    return (patterns || []).some(pattern => pattern.test(source));
  },

  containsWord: function (text, phrase) {
    const source = String(text || "");
    const target = this.normalizeName(phrase);
    if (!source || !target) return false;

    const escaped = this.escapeRegex(target).replace(/\s+/g, "\\s+");

    try {
      return new RegExp(
        "(^|[^\\p{L}\\p{N}_])" +
          escaped +
          "($|[^\\p{L}\\p{N}_])",
        "iu"
      ).test(source);
    } catch (error) {
      return new RegExp(
        "(^|\\W)" + escaped + "($|\\W)",
        "i"
      ).test(source);
    }
  },

  getConfigCard: function () {
    if (!Array.isArray(storyCards)) return null;

    const normalizedKey = String(this.CONFIG_CARD_KEY).toLowerCase();
    const normalizedType = String(this.CONFIG_CARD_TYPE).toLowerCase();

    for (let index = 0; index < storyCards.length; index++) {
      const card = storyCards[index];
      if (!card || typeof card !== "object") continue;

      const keys = String(card.keys || "")
        .split(",")
        .map(value => value.trim().toLowerCase());

      const type = String(card.type || "").toLowerCase();

      if (
        keys.includes(normalizedKey) ||
        type === normalizedType
      ) {
        return {
          card,
          index
        };
      }
    }

    return null;
  },

  buildConfigNotes: function (name, values) {
    const edit = values || {};

    return [
      "Complex REL configuration card.",
      "",
      this.CHARACTER_MARKER,
      name || this.CONFIG_PLACEHOLDER,
      "",
      this.MANUAL_MARKER,
      "Apply: " + (edit.apply ? "yes" : "no"),
      "Friendship: " + (typeof edit.friendship === "undefined" ? "unchanged" : edit.friendship),
      "Romance: " + (typeof edit.romance === "undefined" ? "unchanged" : edit.romance),
      "Trust: " + (typeof edit.trust === "undefined" ? "unchanged" : edit.trust),
      "Affection: " + (typeof edit.affection === "undefined" ? "unchanged" : edit.affection),
      "Attraction: " + (typeof edit.attraction === "undefined" ? "unchanged" : edit.attraction),
      "Comfort: " + (typeof edit.comfort === "undefined" ? "unchanged" : edit.comfort),
      "Jealousy: " + (typeof edit.jealousy === "undefined" ? "unchanged" : edit.jealousy),
      "Stability: " + (typeof edit.stability === "undefined" ? "unchanged" : edit.stability)
    ].join("\n");
  },

  isConfigInstructionLine: function (line) {
    const value = String(line || "").trim();
    const lower = value.toLowerCase();

    if (!value) return true;
    if (value === this.CONFIG_PLACEHOLDER.toLowerCase()) return true;
    if (value.toLowerCase() === this.CONFIG_PLACEHOLDER.toLowerCase()) return true;
    if (value.toLowerCase() === this.MANUAL_MARKER.toLowerCase()) return true;
    if (value.toLowerCase() === this.CHARACTER_MARKER.toLowerCase()) return true;
    if (/^\[.*\]$/.test(value)) return true;
    if (/^apply\s*:/i.test(value)) return true;
    if (/^(friendship|romance|trust|affection|attraction|comfort|jealousy|stability)\s*:/i.test(value)) return true;
    if (lower.includes("complex rel configuration card")) return true;
    if (lower.includes("write the name")) return true;
    if (lower.includes("single romantic interest")) return true;
    if (lower.includes("use a number")) return true;
    if (lower.includes("use unchanged")) return true;
    if (lower.includes("set apply to yes")) return true;

    return false;
  },

  getLegacyConfiguredInterest: function (notes) {
    const lines = String(notes || "")
      .split(/\r?\n/)
      .map(line => line.trim())
      .filter(Boolean);

    for (let index = lines.length - 1; index >= 0; index--) {
      const line = lines[index];
      if (line.toLowerCase() === this.MANUAL_MARKER.toLowerCase()) break;
      if (line.toLowerCase() === this.CHARACTER_MARKER.toLowerCase()) continue;
      if (this.isConfigInstructionLine(line)) continue;
      return line;
    }

    return "";
  },

  getConfiguredInterest: function () {
    const config = this.getConfigCard();
    if (!config || !config.card) return "";

    const notes = String(config.card.description || "");
    const lines = notes
      .split(/\r?\n/)
      .map(line => line.trim());

    let characterMarkerIndex = -1;
    let manualMarkerIndex = lines.length;

    for (let index = 0; index < lines.length; index++) {
      if (lines[index].toLowerCase() === this.CHARACTER_MARKER.toLowerCase()) {
        characterMarkerIndex = index;
      }

      if (lines[index].toLowerCase() === this.MANUAL_MARKER.toLowerCase()) {
        manualMarkerIndex = index;
        break;
      }
    }

    if (characterMarkerIndex >= 0) {
      for (
        let index = characterMarkerIndex + 1;
        index < manualMarkerIndex;
        index++
      ) {
        const line = lines[index];
        if (!line) continue;
        if (line === this.CONFIG_PLACEHOLDER) continue;
        if (this.isConfigInstructionLine(line)) continue;
        return this.normalizeName(line);
      }

      return "";
    }

    return this.normalizeName(
      this.getLegacyConfiguredInterest(notes)
    );
  },

  saveConfigDescription: function (description) {
    const config = this.getConfigCard();
    if (!config || !config.card) return false;

    config.card.description = String(description || "");

    if (typeof updateStoryCard === "function") {
      updateStoryCard(
        config.index,
        String(config.card.keys || this.CONFIG_CARD_KEY),
        String(config.card.entry || ""),
        String(config.card.type || this.CONFIG_CARD_TYPE)
      );
    }

    return true;
  },

  ensureConfigCard: function () {
    const existing = this.getConfigCard();

    if (existing) {
      const notes = String(existing.card.description || "");

      if (!notes.toLowerCase().includes(this.MANUAL_MARKER.toLowerCase())) {
        const configuredName = this.getLegacyConfiguredInterest(notes);

        existing.card.description = this.buildConfigNotes(
          configuredName || "",
          {}
        );

        if (typeof updateStoryCard === "function") {
          updateStoryCard(
            existing.index,
            String(existing.card.keys || this.CONFIG_CARD_KEY),
            String(existing.card.entry || ""),
            String(existing.card.type || this.CONFIG_CARD_TYPE)
          );
        }
      }

      return existing;
    }

    if (typeof addStoryCard !== "function") {
      return null;
    }

    const index = addStoryCard(
      this.CONFIG_CARD_KEY,
      "Complex REL configuration. Configure the romantic interest in Notes.",
      this.CONFIG_CARD_TYPE
    );

    if (
      typeof index !== "number" ||
      index < 0 ||
      !storyCards[index]
    ) {
      return null;
    }

    storyCards[index].description = this.buildConfigNotes("", {});

    if (typeof updateStoryCard === "function") {
      updateStoryCard(
        index,
        this.CONFIG_CARD_KEY,
        String(storyCards[index].entry || ""),
        this.CONFIG_CARD_TYPE
      );
    }

    return {
      card: storyCards[index],
      index
    };
  },

  getAliases: function (name) {
    const cleanName = this.normalizeName(name);
    if (!cleanName) return [];

    const parts = cleanName.split(/\s+/).filter(Boolean);
    const aliases = [cleanName];

    if (parts.length >= 2) {
      aliases.push(parts[0]);
      aliases.push(parts[parts.length - 1]);
    }

    return [...new Set(aliases)];
  },

  nameMatches: function (text, name) {
    return this.getAliases(name).some(alias =>
      this.containsWord(text, alias)
    );
  },

  ensureCharacter: function (name) {
    const relationships = this.init();
    const normalizedName = this.normalizeName(name);

    if (!normalizedName) return null;

    const existingKey = Object.keys(relationships.characters).find(key =>
      this.normalizeName(key).toLowerCase() === normalizedName.toLowerCase()
    );

    const characterName = existingKey || normalizedName;

    if (!relationships.characters[characterName]) {
      relationships.characters[characterName] = {
        friendship: 0,
        romance: 0,
        trust: 50,
        affection: 5,
        attraction: 0,
        comfort: 15,
        jealousy: 0,
        stability: 80,
        history: {
          lastTurn: 0,
          lastEvent: "",
          recentNegative: false,
          recentSupport: false,
          lastSignature: ""
        }
      };
    }

    const character = relationships.characters[characterName];

    if (!character.history || typeof character.history !== "object") {
      character.history = {
        lastTurn: 0,
        lastEvent: "",
        recentNegative: false,
        recentSupport: false,
        lastSignature: ""
      };
    }

    return character;
  },

  getCharacterName: function (name) {
    const relationships = this.init();
    const normalizedName = this.normalizeName(name);

    if (!normalizedName) return "";

    const existingKey = Object.keys(relationships.characters).find(key =>
      this.normalizeName(key).toLowerCase() === normalizedName.toLowerCase()
    );

    return existingKey || normalizedName;
  },

  getCharacter: function (name) {
    const relationships = this.init();
    const canonicalName = this.getCharacterName(name);

    if (!canonicalName || !relationships.characters[canonicalName]) {
      return null;
    }

    return relationships.characters[canonicalName];
  },

  detectInterest: function (cards, contextText) {
    const relationships = this.init();
    const configuredName = this.getConfiguredInterest();

    if (configuredName) {
      relationships.romanticInterest = configuredName;
      return configuredName;
    }

    if (relationships.romanticInterest) {
      return relationships.romanticInterest;
    }

    const text = String(contextText || "");
    const cardList = Array.isArray(cards) ? cards : [];

    for (const card of cardList) {
      if (!card || typeof card !== "object") continue;

      const keys = String(card.keys || "");
      if (!keys) continue;
      if (keys.toLowerCase().includes(this.CONFIG_CARD_KEY.toLowerCase())) continue;
      if (keys.toLowerCase().includes(this.STATUS_CARD_KEY.toLowerCase())) continue;

      const candidates = keys
        .split(/[\n,;|]+/)
        .map(value => this.normalizeName(value))
        .filter(value => value.length >= 2);

      for (const candidate of candidates) {
        if (this.nameMatches(text, candidate)) {
          relationships.romanticInterest = candidate;
          return candidate;
        }
      }
    }

    const existingNames = Object.keys(relationships.characters);

    for (const name of existingNames) {
      if (this.nameMatches(text, name)) {
        relationships.romanticInterest = name;
        return name;
      }
    }

    if (existingNames.length === 1) {
      relationships.romanticInterest = existingNames[0];
      return existingNames[0];
    }

    return "";
  },

  getFriendshipLevel: function (value) {
    if (value <= -61) return "Enemy";
    if (value <= -31) return "Persona Non Grata";
    if (value <= 10) return "Neutral";
    if (value <= 30) return "Acquaintance";
    if (value <= 55) return "Friend";
    if (value <= 80) return "Good Friend";
    return "Best Friends";
  },

  getRomanceLevel: function (value) {
    if (value <= 0) return "No Romantic Interest";
    if (value <= 20) return "Mild Attraction";
    if (value <= 40) return "Romantic Interest";
    if (value <= 65) return "Falling in Love";
    if (value <= 85) return "Sweethearts";
    return "Soulmates";
  },

  getTrustLevel: function (value) {
    if (value >= 80) return "Secure";
    if (value >= 60) return "Trusting";
    if (value >= 40) return "Wary";
    if (value >= 20) return "Jealous";
    return "Possessive";
  },

  getAffectionLevel: function (value) {
    if (value < 20) return "Indifferent";
    if (value < 40) return "Fond";
    if (value < 60) return "Attached";
    if (value < 80) return "Deeply Attached";
    return "Devoted";
  },

  getAttractionLevel: function (value) {
    if (value < 10) return "None";
    if (value < 30) return "Curious";
    if (value < 55) return "Attracted";
    if (value < 80) return "Strongly Attracted";
    return "Intense Attraction";
  },

  getComfortLevel: function (value) {
    if (value < 20) return "Distant";
    if (value < 40) return "Cautious";
    if (value < 60) return "Comfortable";
    if (value < 80) return "Close";
    return "Intimate";
  },

  getJealousyLevel: function (value) {
    if (value < 15) return "Calm";
    if (value < 35) return "Alert";
    if (value < 60) return "Jealous";
    if (value < 80) return "Highly Jealous";
    return "Obsessive";
  },

  getStabilityLevel: function (value) {
    if (value >= 80) return "Stable";
    if (value >= 60) return "Strained";
    if (value >= 40) return "Unstable";
    if (value >= 20) return "Distressed";
    return "Crisis";
  },

  /* ---------------------------------------------------------
     ROMANTIC RECIPROCITY
     --------------------------------------------------------- */

  detectStrongRomanticReciprocity: function (name, input, output) {
    const source = String(output || "")
      .replace(/[“”]/g, '"')
      .replace(/[’]/g, "'")
      .replace(/\s+/g, " ")
      .trim();

    const playerInput = String(input || "")
      .replace(/[“”]/g, '"')
      .replace(/[’]/g, "'")
      .replace(/\s+/g, " ")
      .trim();

    if (!source || !playerInput) return false;

    const aliases = this.getAliases(name);
    if (!aliases.length) return false;

    const escapedAliases = aliases.map(alias => this.escapeRegex(alias));
    const aliasRegex = new RegExp(
      "\\b(?:" + escapedAliases.join("|") + ")\\b",
      "i"
    );

    const subjectPattern =
      "(?:" + escapedAliases.join("|") + "|they|he|she)";

    const sentences = source
      .split(/(?:[.!?]+\s+|\r?\n+)/)
      .map(sentence => sentence.trim())
      .filter(Boolean);

    if (!sentences.some(sentence => aliasRegex.test(sentence))) {
      return false;
    }

    const refusalBeforePattern =
      /\b(?:doesn't|does not|didn't|did not|won't|will not|never|refuses?|refused|rejects?|rejected|pulls? away|pulled away|turns? away|turned away|backs? away|backed away|avoids?|avoided)\b/i;

    const intentBeforePattern =
      /\b(?:will|would|might|could|should|want(?:s)? to|wanted to|hope(?:s)? to|hoped to|plan(?:s)? to|planned to|think(?:s)? about|thought about|tries? to|tried to|attempts? to|attempted to|considers?|considered|wishes? to|wished to|almost|nearly)\b/i;

    const playerRejectionPattern =
      /\b(?:you|the player)\b[^.!?]{0,80}\b(?:pulls? away|pulled away|turns? away|turned away|rejects?|rejected|refuses?|refused|backs? away|backed away|says? no|said no)\b/i;

    const reciprocalPatterns = {
      kiss:
        /(?:kisses?|kissed)\s+you(?:\s+(?:back|again))?|returns?\s+(?:your\s+|the\s+)?kiss|deepens?\s+(?:the\s+)?kiss|leans?\s+in(?:\s+closer)?\s+(?:and\s+)?kisses?\s+you|presses?\s+(?:their|his|her)\s+lips\s+(?:against|to)\s+yours|meets?\s+your\s+(?:lips|mouth)|brushes?\s+(?:their|his|her)\s+lips\s+against\s+yours|touches?\s+(?:their|his|her)\s+lips\s+to\s+yours|seeks?\s+your\s+lips|captures?\s+your\s+lips|pulls?\s+you\s+(?:into|closer\s+for)\s+(?:a\s+)?kiss|initiates?\s+(?:a\s+)?kiss/i,

      flirt:
        /flirts?\s+back|flirted\s+back|reciprocates?\s+(?:your\s+)?flirting|reciprocated\s+(?:your\s+)?flirting|returns?\s+(?:the\s+)?flirtation|teases?\s+you\s+(?:playfully|flirtatiously)|flirtatiously\s+teases?\s+you/i,

      date:
        /agrees?\s+to\s+(?:go\s+on\s+)?(?:a\s+)?date\s+with\s+you|accepts?\s+(?:your\s+)?(?:date\s+)?invitation|asks?\s+you\s+out|invites?\s+you\s+(?:out|on\s+(?:a\s+)?date)|suggests?\s+(?:a\s+)?date(?:\s+with\s+you)?|proposes?\s+(?:a\s+)?date|plans?\s+(?:a\s+)?date\s+with\s+you|wants?\s+to\s+go\s+on\s+(?:a\s+)?date\s+with\s+you/i,

      touch:
        /hugs?\s+you\s+back|embraces?\s+you|returns?\s+(?:your\s+)?hug|cuddles?\s+(?:closer|with\s+you)|pulls?\s+you\s+(?:closer|into\s+(?:their|his|her)\s+(?:arms|embrace))|holds?\s+(?:your\s+hand|hands?\s+with\s+you)|takes?\s+your\s+hand|squeezes?\s+your\s+hand|laces?\s+(?:their|his|her)\s+fingers?\s+with\s+yours|leans?\s+into\s+your\s+touch|returns?\s+your\s+touch/i,

      gift:
        /returns?\s+the\s+(?:romantic\s+)?gesture|gives?\s+you\s+(?:a\s+)?(?:romantic\s+)?gift(?:\s+in\s+return)?|gives?\s+you\s+flowers?|gives?\s+you\s+roses?|gives?\s+you\s+jewelry|hands?\s+you\s+(?:something|a\s+gift)\s+in\s+return|returns?\s+the\s+gift/i,

      words:
        /says?\s+(?:they\s+)?love\s+you\s+too|tells?\s+you\s+(?:they\s+)?love\s+you|admits?\s+(?:their\s+)?feelings\s+for\s+you|confesses?\s+(?:their\s+)?feelings|says?\s+they\s+have\s+feelings\s+for\s+you|says?\s+they\s+want\s+to\s+be\s+with\s+you|returns?\s+your\s+confession|reciprocates?\s+your\s+feelings/i,

      time:
        /agrees?\s+to\s+spend\s+(?:more\s+)?time\s+with\s+you|asks?\s+you\s+to\s+stay|suggests?\s+spending\s+(?:more\s+)?time\s+(?:together|with\s+you)|wants?\s+you\s+to\s+stay\s+(?:with\s+them|with\s+her|with\s+him)|suggests?\s+being\s+alone\s+with\s+you|asks?\s+to\s+spend\s+time\s+alone\s+with\s+you|suggests?\s+(?:just\s+the\s+two\s+of\s+you|a\s+private\s+evening\s+together)/i
    };

    const inputPatterns = {
      kiss: /\b(?:kiss|kisses|kissed|kissing|make out|making out)\b/i,
      flirt: /\b(?:flirt|flirts|flirted|flirting|flirty|seduce|seductive)\b/i,
      date: /\b(?:date|dating|go out with me|ask(?:ed)?\s+[^.!?]{0,40}\s+out|take you out|romantic outing|dinner date)\b/i,
      touch: /\b(?:romantic(?:ally)?|tender(?:ly)?|intimate(?:ly)?|affectionate(?:ly)?|loving(?:ly)?|hold hands?|holding hands?|cuddle|cuddling|embrace|embracing|caress|caressing)\b/i,
      gift: /\b(?:romantic gift|romantic present|love letter|roses?|bouquet|jewelry|necklace|bracelet|valentine(?:'s)? gift)\b/i,
      words: /\b(?:i love you|love you|my feelings for you|confess(?: my)? feelings|romantic feelings|want to be with you|tell\s+[^.!?]{0,40}\s+you\s+(?:that\s+)?i\s+(?:love|adore)|say\s+[^.!?]{0,40}\s+(?:i\s+)?love)\b/i,
      time: /\b(?:romantic date|romantic outing|romantic evening|spend time alone|spend the evening alone|just the two of us|one[- ]on[- ]one|private evening|alone together)\b/i
    };

    const candidateCategories = Object.keys(reciprocalPatterns)
      .filter(category => inputPatterns[category].test(playerInput));

    if (!candidateCategories.length) return false;

    for (let sentenceIndex = 0; sentenceIndex < sentences.length; sentenceIndex++) {
      const sentence = sentences[sentenceIndex];
      const previousSentence = sentenceIndex > 0 ? sentences[sentenceIndex - 1] : "";

      if (
        !aliasRegex.test(sentence) &&
        !aliasRegex.test(previousSentence)
      ) {
        continue;
      }

      const subjectRegex = new RegExp(
        "\\b" + subjectPattern + "\\b",
        "gi"
      );

      let subjectMatch;

      while ((subjectMatch = subjectRegex.exec(sentence)) !== null) {
        const afterSubject = sentence.slice(
          subjectMatch.index + subjectMatch[0].length
        );

        const actionWindow = afterSubject.slice(0, 180);

        for (const category of candidateCategories) {
          const actionMatch = actionWindow.match(reciprocalPatterns[category]);

          if (!actionMatch) continue;

          const beforeAction = actionWindow.slice(
            0,
            actionMatch.index
          );

          if (refusalBeforePattern.test(beforeAction)) continue;
          if (intentBeforePattern.test(beforeAction)) continue;
          if (playerRejectionPattern.test(afterSubject)) continue;
          if (playerRejectionPattern.test(sentences[sentenceIndex + 1] || "")) continue;

          return true;
        }
      }
    }

    return false;
  },

  /* ---------------------------------------------------------
     ORIGINAL RELATIONSHIP SIGNALS
     These continue to use ONLY the current input and output.
     Stability uses a stricter detector below.
     --------------------------------------------------------- */

  analyzeInteraction: function (name, input, output) {
    const combined =
      String(input || "") +
      "\n" +
      String(output || "");

    return {
      spentTime: this.hasAny(combined, [
        /\bspend(?:s|ing)?\s+(?:some\s+)?time\b/i,
        /\bspent\s+(?:the|an|a)\s+(?:afternoon|evening|day|morning|night)\b/i,
        /\bhang(?:s|ing)?\s+out\b/i,
        /\bvisit(?:s|ed|ing)?\b/i,
        /\bjoined?\b/i
      ]),

      sharedActivity: this.hasAny(combined, [
        /\b(?:play|played|playing|practice|practiced|practicing|watch|watched|watching|cook|cooked|cooking|skate|skated|listen|listened|listening)\b[^.!?]{0,80}\btogether\b/i,
        /\btogether\b/i
      ]),

      trivialConversation: this.hasAny(combined, [
        /\b(?:talk|talked|talking|chat|chatted|chatting|conversation|conversed)\b/i,
        /\bsmall\s+talk\b/i
      ]),

      joking: this.hasAny(combined, [
        /\b(?:joke|joked|joking|tease|teased|teasing|laugh|laughed|laughing|banter)\b/i
      ]),

      caredFor: this.hasAny(combined, [
        /\b(?:care|cared|caring|look\s+after|looked\s+after|takes?\s+care|took\s+care|help|helped|helping|comfort|comforted|comforting|check\s+on|checked\s+on)\b/i
      ]),

      intimateSharing: this.hasAny(combined, [
        /\b(?:confide|confided|confiding|open(?:ed|s)?\s+up|vulnerable|vulnerability|personal\s+secret|deep\s+secret|share(?:d)?\s+(?:something|a)\s+(?:personal|private|deep))\b/i
      ]),

      transparent: this.hasAny(combined, [
        /\b(?:honest|honestly|truthful|truthfully|tell(?:ing)?\s+the\s+truth|came\s+clean|admit(?:ted|ting)?)\b/i
      ]),

      support: this.hasAny(combined, [
        /\b(?:support|supported|supporting|encourage|encouraged|encouraging|be\s+there|was\s+there|stood\s+by)\b/i
      ]),

      neglect: this.hasAny(combined, [
        /\b(?:ignore|ignored|ignoring|neglect|neglected|neglecting|forgot|forgetting|let\s+down|left\s+waiting|stood\s+up)\b/i
      ]),

      betrayal: this.hasAny(combined, [
        /\b(?:betray|betrayed|betraying|betrayal|backstab|backstabbed|cheat(?:ed|ing)?|lied\s+to|lie\s+to)\b/i
      ]),

      argument: this.hasAny(combined, [
        /\b(?:argue|argued|arguing|argument|fight|fought|fighting|shout|shouted|shouting|yell|yelled|yelling|heated\s+argument)\b/i
      ]),

      seriousHurt: this.hasAny(combined, [
        /\b(?:seriously\s+hurt|deeply\s+hurt|deeply\s+wound|wounded|devastated|heartbroken|crushed|traumatized|humiliated|humiliated\s+them|humiliate\s+them)\b/i
      ]),

      flirting: this.hasAny(combined, [
        /\b(?:flirt|flirts|flirted|flirting|flirty|seductive|seductively|wink|winks|winked|winked\s+at)\b/i
      ]),

      romanticPhysical: this.hasAny(combined, [
        /\b(?:kiss|kissed|kissing|cuddle|cuddled|cuddling|hug|hugged|hugging|embrace|embraced|caress|caressed|caressing|hold\s+hands?|held\s+hands?|intertwine(?:d|s)?\s+(?:their|your)\s+fingers?|touch(?:ed|ing)?\s+(?:their|your)\s+(?:cheek|face|hair))\b/i
      ]),

      romanticReciprocity: this.detectStrongRomanticReciprocity(
        name,
        input,
        output
      ),

      romanticRefusal: this.hasAny(String(output || ""), [
        /\b(?:rejects?|rejected|refuses?|refused|turns?\s+away|turned\s+away|pulls?\s+away|pulled\s+away|backs?\s+away|backed\s+away|doesn't\s+want|does\s+not\s+want|not\s+interested|stop(?:s|ped)?\s+(?:the\s+)?kiss)\b/i
      ]),

      rivalInteraction: this.hasAny(combined, [
        /\b(?:flirt(?:s|ed|ing)?|kiss(?:es|ed|ing)?|hug(?:s|ged|ging)?|date(?:s|d|ting)?|romance(?:s|d|ing)?|dance(?:s|d|ing)?)\b[\s\S]{0,100}\b(?:another|someone\s+else|other|rival|ex|stranger)\b/i,
        /\b(?:another|someone\s+else|other|rival|ex)\b[\s\S]{0,100}\b(?:flirt|kiss|date|romance|dance)\b/i
      ]),

      secrecyAboutOthers: this.hasAny(combined, [
        /\b(?:secret|secrecy|hide|hiding|hidden|keep(?:ing)?\s+it\s+from|kept\s+it\s+from)\b[\s\S]{0,100}\b(?:another|someone\s+else|other|ex|rival)\b/i,
        /\b(?:another|someone\s+else|other|ex|rival)\b[\s\S]{0,100}\b(?:secret|secrecy|hide|hiding|hidden)\b/i
      ]),

      failure: this.hasAny(combined, [
        /\b(?:failed|failure|mess(?:ed)?\s+up|screwed\s+up|ruined|disappoint(?:ed|ing)|let\s+down)\b/i
      ]),

      isolation: this.hasAny(combined, [
        /\b(?:isolate|isolated|isolating|alone|lonely|loneliness|shut\s+(?:them|him|her)self\s+away|withdraw(?:n|s|ing)?)\b/i
      ]),

      selfDestructive: this.hasAny(combined, [
        /\b(?:self[-\s]?destructive|hurt(?:s|ing)?\s+themself|hurt(?:s|ing)?\s+himself|hurt(?:s|ing)?\s+herself|reckless|recklessly|dangerous\s+behavior|self[-\s]?sabotage|binge\s+drinking|get(?:s)?\s+drunk|chain[-\s]?smok(?:e|es|ed|ing))\b/i
      ]),

      positiveRecovery: this.hasAny(combined, [
        /\b(?:recover(?:ed|y|ing)?|reconcile(?:d|s|ing)?|make\s+amends|made\s+amends|heal(?:ed|ing)|healing|apolog(?:y|ize|ized|izing)|forgive|forgave|forgiven)\b/i
      ]),

      musicMilestone: this.hasAny(combined, [
        /\b(?:music|song|track|performance|concert|rehearsal|recording|demo)\b[\s\S]{0,80}\b(?:milestone|breakthrough|success|successful|finally|first\s+time)\b/i,
        /\b(?:milestone|breakthrough|success|successful|first\s+time)\b[\s\S]{0,80}\b(?:music|song|track|performance|concert|rehearsal|recording|demo)\b/i
      ])
    };
  },

  /* ---------------------------------------------------------
     STRICT STABILITY DETECTION

     This is intentionally separate from the general interaction
     signals. Stability reacts only to explicit current-turn actions
     and strong current-turn consequences, not generic mentions.
     --------------------------------------------------------- */

  detectStabilitySignals: function (input, output, name) {
    const playerInput = String(input || "");
    const aiOutput = String(output || "");
    const combined = playerInput + "\n" + aiOutput;

    const aliases = this.getAliases(name);
    const escapedAliases = aliases.map(alias => this.escapeRegex(alias));
    const namePattern = escapedAliases.length
      ? "(?:" + escapedAliases.join("|") + "|they|he|she|you|we)"
      : "(?:they|he|she|you|we)";

    const subjectRegex = new RegExp(
      "\\b" + namePattern + "\\b",
      "i"
    );

    const retrospectivePattern =
      /\b(?:yesterday|last\s+(?:night|day|week|month|year)|earlier|previously|before|in\s+the\s+past|used\s+to|remember(?:s|ed)?|recall(?:s|ed)?|recalled|mentioned|mentions|discuss(?:es|ed)?|talk(?:s|ed)?\s+about|explains?|explained|describes?|described|recount(?:s|ed)?|mention(?:s|ed)?)\b/i;

    const currentSentences = combined
      .split(/(?:[.!?]+\s*|\r?\n+)/)
      .map(sentence => sentence.trim())
      .filter(Boolean);

    const hasActiveSubjectAction = patterns => {
      return currentSentences.some(sentence => {
        if (retrospectivePattern.test(sentence)) return false;
        if (!subjectRegex.test(sentence)) return false;
        return patterns.some(pattern => pattern.test(sentence));
      });
    };

    const argument =
      hasActiveSubjectAction([
        /\b(?:argue|argued|arguing|are arguing|were arguing|confront|confronted|confronting|confronts|fought|fighting|shout|shouted|shouting|yell|yelled|yelling|scream|screamed|screaming)\b/i,
        /\b(?:raise|raised)\s+(?:your|their|our)\s+voice\b/i,
        /\b(?:heated\s+argument|serious\s+argument)\b/i
      ]);

    const seriousHurt =
      hasActiveSubjectAction([
        /\b(?:deliberately|intentionally)?\s*(?:humiliate|humiliated|insult|insulted|betray|betrayed|threaten|threatened|weaponize|weaponized|used\s+.*\s+against)\b/i,
        /\b(?:deeply\s+hurt|seriously\s+hurt|heartbroken|devastated|crushed|humiliated|wounded)\b/i
      ]);

    const failure =
      hasActiveSubjectAction([
        /\b(?:failed|fails|fail|have\s+failed|has\s+failed)\s+(?:to|at)\b/i,
        /\b(?:attempt|attempted|try|tried|plans?|planned)\b[\s\S]{0,80}\b(?:fails?|failed|failure)\b/i,
        /\b(?:the\s+plan|the\s+attempt|your\s+plan|their\s+plan)\b[\s\S]{0,60}\b(?:failed|fails|failure)\b/i
      ]);

    const isolation =
      hasActiveSubjectAction([
        /\b(?:walk(?:s|ed)?\s+away|leave(?:s|d)?\s+the\s+room|withdraw(?:s|n|ing)?|shut\s+(?:your|their|himself|herself|themselves)\s+(?:away|out)|cut(?:s)?\s+(?:yourself|themselves)\s+off|isolat(?:e|es|ed|ing)\b)/i,
        /\b(?:deliberately|intentionally)\s+(?:stay|stays|stayed|remains?|remain|isolates?)\s+alone\b/i
      ]);

    const selfDestructive =
      hasActiveSubjectAction([
        /\b(?:hurt(?:s|ing)?\s+(?:yourself|themselves|himself|herself)|burn(?:s|ed|ing)?\s+(?:yourself|themselves|himself|herself)|overdose|dangerously\s+drink|binge\s+drink|gets?\s+drunk|drink(?:s|ing)?\s+heavily|chain[-\s]?smok(?:e|es|ed|ing)|reckless(?:ly)?\s+(?:drive|drives|drove|ride|rides|fight|fights|fought)|self[-\s]?destruct(?:ive|s|ed|ively)?|self[-\s]?sabotage(?:s|d|ing)?)\b/i
      ]);

    const positiveRecovery =
      hasActiveSubjectAction([
        /\b(?:apolog(?:ize|ized|izes|izing)|make\s+amends|made\s+amends|reconcile(?:d|s|ing)?|forgive(?:s|d|n)?|recover(?:s|ed|ing)?|start(?:s|ed)?\s+healing|begin(?:s|an)?\s+to\s+heal)\b/i,
        /\b(?:finally|begins?|starts?)\b[\s\S]{0,80}\b(?:healing|recovering|feeling\s+better|hopeful)\b/i
      ]);

    const musicMilestone =
      hasActiveSubjectAction([
        /\b(?:finish(?:ed)?|complete(?:d)?|record(?:ed)?|perform(?:ed)?|nail(?:ed)?|pull(?:ed)?\s+off|write|wrote|release(?:d)?|book(?:ed)?)\b[\s\S]{0,80}\b(?:song|track|recording|performance|concert|rehearsal|demo)\b/i,
        /\b(?:song|track|recording|performance|concert|rehearsal|demo)\b[\s\S]{0,80}\b(?:finally\s+succeeded|breakthrough|milestone|first\s+time|success)\b/i
      ]);

    const support =
      hasActiveSubjectAction([
        /\b(?:support(?:ed|s|ing)?\s+(?:you|them|him|her)|comfort(?:ed|s|ing)?\s+(?:you|them|him|her)|reassur(?:ed|es|ing)\s+(?:you|them|him|her)|encourag(?:ed|es|ing)\s+(?:you|them|him|her)|help(?:ed|s|ing)\s+(?:you|them|him|her)|stood\s+by\s+(?:you|them|him|her)|be\s+there\s+for\s+(?:you|them|him|her)|was\s+there\s+for\s+(?:you|them|him|her))\b/i
      ]);

    const priority = [
      ["selfDestructive", selfDestructive, 8],
      ["seriousHurt", seriousHurt, 7],
      ["argument", argument, 6],
      ["failure", failure, 5],
      ["isolation", isolation, 4],
      ["positiveRecovery", positiveRecovery, 3],
      ["musicMilestone", musicMilestone, 2],
      ["support", support, 1]
    ];

    let selectedEvent = "NONE";
    let selectedPriority = 0;

    for (const item of priority) {
      if (item[1] && item[2] > selectedPriority) {
        selectedEvent = item[0]
          .replace(/^[a-z]/, letter => letter.toUpperCase())
          .replace(/[A-Z]/g, letter => "_" + letter)
          .toUpperCase()
          .replace(/^_/, "");
        selectedPriority = item[2];
      }
    }

    return {
      argument,
      seriousHurt,
      failure,
      isolation,
      selfDestructive,
      positiveRecovery,
      musicMilestone,
      support,
      event: selectedEvent,
      priority: selectedPriority
    };
  },

  applyManualEdit: function () {
    const relationships = this.init();
    const name = this.getConfiguredInterest();
    const edit = this.parseManualEdit();

    if (!name || !edit || !edit.apply) {
      return {
        applied: false,
        changed: false,
        name: name || ""
      };
    }

    const character = this.ensureCharacter(name);

    if (!character) {
      return {
        applied: false,
        changed: false,
        name: name || ""
      };
    }

    relationships.romanticInterest = name;

    let changed = false;

    const statNames = [
      "friendship",
      "romance",
      "trust",
      "affection",
      "attraction",
      "comfort",
      "jealousy",
      "stability"
    ];

    for (const stat of statNames) {
      const value = edit.values[stat];

      if (typeof value !== "number" || !isFinite(value)) {
        continue;
      }

      const limits = this.STAT_LIMITS[stat];

      character[stat] = this.clamp(
        this.round1(value),
        limits.min,
        limits.max
      );

      changed = true;
    }

    character.history.lastTurn = relationships.turn;
    character.history.lastEvent = changed ? "MANUAL_EDIT" : "";
    character.history.recentNegative = false;
    character.history.recentSupport = false;
    character.history.lastSignature = "";

    this.disableManualEdit();

    relationships.__relSkipNextOutputAnalysis = true;

    return {
      applied: true,
      changed,
      name,
      character
    };
  },

  parseManualEdit: function () {
    const config = this.getConfigCard();

    if (!config || !config.card) {
      return null;
    }

    const lines = String(config.card.description || "")
      .split(/\r?\n/)
      .map(line => line.trim());

    let manualIndex = -1;

    for (let index = 0; index < lines.length; index++) {
      if (
        lines[index].toLowerCase() ===
        this.MANUAL_MARKER.toLowerCase()
      ) {
        manualIndex = index;
        break;
      }
    }

    if (manualIndex < 0) {
      return null;
    }

    const result = {
      apply: false,
      values: {}
    };

    const statNames = [
      "friendship",
      "romance",
      "trust",
      "affection",
      "attraction",
      "comfort",
      "jealousy",
      "stability"
    ];

    for (
      let index = manualIndex + 1;
      index < lines.length;
      index++
    ) {
      const line = lines[index];

      if (!line) continue;

      const applyMatch = line.match(
        /^apply\s*:\s*(.+)$/i
      );

      if (applyMatch) {
        const value = applyMatch[1]
          .trim()
          .toLowerCase();

        result.apply =
          value === "yes" ||
          value === "true" ||
          value === "on" ||
          value === "1";

        continue;
      }

      const statMatch = line.match(
        /^(friendship|romance|trust|affection|attraction|comfort|jealousy|stability)\s*:\s*(.+)$/i
      );

      if (!statMatch) continue;

      const stat = statMatch[1].toLowerCase();
      const rawValue = statMatch[2].trim();

      if (
        rawValue.toLowerCase() === "unchanged" ||
        rawValue === ""
      ) {
        result.values[stat] = null;
        continue;
      }

      const numericValue = Number(rawValue);

      if (isFinite(numericValue)) {
        result.values[stat] = numericValue;
      }
    }

    for (const stat of statNames) {
      if (
        !Object.prototype.hasOwnProperty.call(
          result.values,
          stat
        )
      ) {
        result.values[stat] = null;
      }
    }

    return result;
  },

  disableManualEdit: function () {
    const config = this.getConfigCard();

    if (!config || !config.card) {
      return false;
    }

    const lines = String(config.card.description || "")
      .split(/\r?\n/)
      .map(line => {

        if (/^\s*apply\s*:/i.test(line)) {
          return "Apply: no";
        }

        if (
          /^\s*(friendship|romance|trust|affection|attraction|comfort|jealousy|stability)\s*:/i.test(line)
        ) {
          const match = line.match(
            /^\s*([^:]+):/
          );

          return (
            match ? match[1] : line
          ).trim() + ": unchanged";
        }

        return line;
      });

    return this.saveConfigDescription(
      lines.join("\n")
    );
  },

  /* ---------------------------------------------------------
     UPDATE CHARACTER
     --------------------------------------------------------- */

  updateCharacter: function (name, input, output) {
    const relationships = this.init();

    if (relationships.__relSkipNextOutputAnalysis) {

      relationships.__relSkipNextOutputAnalysis = false;
      relationships.lastOutput = String(output || "");

      return this.getCharacter(name);
    }

    const canonicalName = this.getCharacterName(name);
    const character = this.ensureCharacter(canonicalName);

    if (!character) {
      return null;
    }

    const signals = this.analyzeInteraction(
      canonicalName,
      input,
      output
    );

    const stabilitySignals = this.detectStabilitySignals(
      input,
      output,
      canonicalName
    );

    let friendshipDelta = 0;
    let romanceDelta = 0;
    let trustDelta = 0;
    let affectionDelta = 0;
    let attractionDelta = 0;
    let comfortDelta = 0;
    let jealousyDelta = 0;
    let stabilityDelta = 0;

    if (signals.spentTime || signals.sharedActivity) {
      friendshipDelta += 0.9;
    }

    if (signals.trivialConversation || signals.joking) {
      friendshipDelta += 0.45;
    }

    if (
      signals.argument ||
      signals.neglect ||
      signals.betrayal
    ) {
      friendshipDelta -= 1.5;
    }

    if (signals.seriousHurt) {
      friendshipDelta -= 2.5;
    }

    if (signals.caredFor) {
      trustDelta += 1.25;
    }

    if (signals.intimateSharing) {
      trustDelta += 1.5;
    }

    if (signals.transparent) {
      trustDelta += 1.5;
    }

    if (signals.support) {
      trustDelta += 0.9;
    }

    if (signals.betrayal) {
      trustDelta -= 3.5;
    }

    if (signals.neglect) {
      trustDelta -= 1.25;
    }

    if (signals.seriousHurt) {
      trustDelta -= 2;
    }

    if (signals.argument) {
      trustDelta -= 0.75;
    }

    if (signals.caredFor) {
      affectionDelta += 1;
    }

    if (signals.support) {
      affectionDelta += 1;
    }

    if (
      signals.spentTime ||
      signals.sharedActivity
    ) {
      affectionDelta += 0.35;
    }

    if (signals.romanticPhysical) {
      affectionDelta += 0.55;
    }

    if (signals.intimateSharing) {
      affectionDelta += 0.7;
    }

    if (signals.neglect) {
      affectionDelta -= 1;
    }

    if (signals.betrayal) {
      affectionDelta -= 2;
    }

    if (signals.flirting) {
      attractionDelta += 1.2;
    }

    if (signals.romanticPhysical) {
      attractionDelta += 1;
    }

    if (
      signals.flirting &&
      signals.romanticReciprocity
    ) {
      attractionDelta += 0.9;
    }

    if (signals.romanticRefusal) {
      attractionDelta -= 0.5;
    }

    if (signals.romanticReciprocity) {

      romanceDelta += 1.4;

      if (
        character.friendship >= 30 &&
        character.trust >= 50 &&
        character.comfort >= 35
      ) {
        romanceDelta += 0.6;
      }

      if (
        character.attraction >= 25 ||
        character.affection >= 20
      ) {
        romanceDelta += 0.45;
      }
    }

    if (signals.romanticRefusal) {
      romanceDelta -= 1;
    }

    if (
      signals.betrayal &&
      character.romance > 0
    ) {
      romanceDelta -= 2;
    }

    if (
      signals.seriousHurt &&
      character.romance > 0
    ) {
      romanceDelta -= 1;
    }

    if (signals.rivalInteraction) {

      jealousyDelta += (
        character.affection >= 40 ||
        character.romance >= 20
      ) ? 2 : 0.5;

      if (character.trust < 40) {
        jealousyDelta += 1.5;
      }
    }

    if (signals.secrecyAboutOthers) {

      if (character.romance >= 20) {
        jealousyDelta += 1.5;
      } else if (character.trust < 50) {
        jealousyDelta += 1;
      }
    }

    if (
      signals.caredFor ||
      signals.support
    ) {
      comfortDelta += 0.9;
    }

    if (signals.intimateSharing) {
      comfortDelta += 0.8;
    }

    if (
      signals.romanticPhysical &&
      character.comfort >= 30
    ) {
      comfortDelta += 0.7;
    }

    if (signals.neglect) {
      comfortDelta -= 1;
    }

    if (signals.betrayal) {
      comfortDelta -= 2;
    }

    if (signals.argument) {
      comfortDelta -= 0.8;
    }

    if (signals.romanticRefusal) {
      comfortDelta -= 0.5;
    }

    /*
     Stability uses strict current-turn detection only.
     */

    if (stabilitySignals.argument) {
      stabilityDelta -= 4;
    }

    if (stabilitySignals.seriousHurt) {
      stabilityDelta -= 5;
    }

    if (stabilitySignals.failure) {
      stabilityDelta -= 4;
    }

    if (stabilitySignals.isolation) {
      stabilityDelta -= 2;
    }

    if (stabilitySignals.selfDestructive) {
      stabilityDelta -= 6;
    }

    if (stabilitySignals.positiveRecovery) {
      stabilityDelta += 4;
    }

    if (stabilitySignals.musicMilestone) {
      stabilityDelta += 2;
    }

    if (stabilitySignals.support) {
      stabilityDelta += 0.6;
    }

    if (
      character.trust < 40 &&
      character.comfort < 30 &&
      character.jealousy >= 60
    ) {
      stabilityDelta -= 1.5;
    }

    if (
      !signals.rivalInteraction &&
      !signals.secrecyAboutOthers
    ) {
      jealousyDelta -= 0.15;
    }

    if (
      !stabilitySignals.argument &&
      !stabilitySignals.seriousHurt &&
      !stabilitySignals.failure &&
      !stabilitySignals.isolation &&
      !stabilitySignals.selfDestructive &&
      character.stability < 80
    ) {
      stabilityDelta += 0.1;
    }

    character.friendship = this.clamp(
      this.round1(
        character.friendship + friendshipDelta
      ),
      -100,
      100
    );

    character.romance = this.clamp(
      this.round1(
        character.romance + romanceDelta
      ),
      -100,
      100
    );

    character.trust = this.clamp(
      this.round1(
        character.trust + trustDelta
      ),
      0,
      100
    );

    character.affection = this.clamp(
      this.round1(
        character.affection + affectionDelta
      ),
      0,
      100
    );

    character.attraction = this.clamp(
      this.round1(
        character.attraction + attractionDelta
      ),
      0,
      100
    );

    character.comfort = this.clamp(
      this.round1(
        character.comfort + comfortDelta
      ),
      0,
      100
    );

    character.jealousy = this.clamp(
      this.round1(
        character.jealousy + jealousyDelta
      ),
      0,
      100
    );

    character.stability = this.clamp(
      this.round1(
        character.stability + stabilityDelta
      ),
      0,
      100
    );

    const activeEvents = Object.keys(signals)
      .filter(key => signals[key]);

    if (stabilitySignals.event !== "NONE") {
      activeEvents.push(
        "stability:" + stabilitySignals.event
      );
    }

    character.history.lastTurn =
      Number(relationships.turn || 0);

    character.history.recentNegative =
      Boolean(
        stabilitySignals.argument ||
        stabilitySignals.seriousHurt ||
        signals.betrayal ||
        signals.neglect ||
        stabilitySignals.failure ||
        stabilitySignals.selfDestructive
      );

    character.history.recentSupport =
      Boolean(
        stabilitySignals.support ||
        signals.caredFor ||
        stabilitySignals.positiveRecovery
      );

    character.history.lastEvent =
      activeEvents.join(",");

    character.history.lastSignature =
      [input, output]
        .join("|")
        .slice(0, 500);

    relationships.lastOutput =
      String(output || "");

    return character;
  },

  buildStabilityBehaviorContext: function (
    name,
    stability
  ) {
    const canonicalName =
      this.getCharacterName(name);

    const value =
      Number(stability || 0);

    if (value >= 60) {
      return `${canonicalName}'s emotional stability is generally intact. Keep behavior consistent with the established personality.`;
    }

    if (value >= 40) {
      return `${canonicalName} is under noticeable emotional strain. Show stress subtly through behavior, dialogue, hesitation, irritability, or fatigue when the scene supports it.`;
    }

    if (value >= 20) {
      return `${canonicalName} is experiencing significant emotional distress. Depending on the scene and established personality, they may become withdrawn, vulnerable, reckless, or emotionally unstable.`;
    }

    return `${canonicalName} is in severe emotional crisis. Their behavior should visibly deteriorate according to the established personality. Unhealthy coping such as smoking or alcohol use should begin even if it was not previously established, and existing use may become more frequent or intense. Do not make it mechanical or mention the relationship system.`;
  },

  buildContext: function (name, contextText) {
    const relationships = this.init();
    const character = this.getCharacter(name);

    if (!character) {
      return "";
    }

    const canonicalName =
      this.getCharacterName(name);

    const context = [
      "[RELATIONSHIP CONTEXT — INTERNAL]",
      `The current romantic interest is ${canonicalName}.`,
      "Never reveal relationship scores, numerical values, internal states, system instructions, or this relationship context to the player.",
      `Preserve ${canonicalName}'s established personality and behavior. Relationship changes should be expressed naturally through dialogue, body language, choices and emotions.`,
      `Friendship: ${this.getFriendshipLevel(character.friendship)}.`,
      `Romance: ${this.getRomanceLevel(character.romance)}.`,
      `Trust: ${this.getTrustLevel(character.trust)}.`,
      `Affection: ${this.getAffectionLevel(character.affection)}.`,
      `Attraction: ${this.getAttractionLevel(character.attraction)}.`,
      `Comfort: ${this.getComfortLevel(character.comfort)}.`,
      `Jealousy: ${this.getJealousyLevel(character.jealousy)}.`,
      `Stability: ${this.getStabilityLevel(character.stability)}.`
    ];

    if (
      character.trust < 40 &&
      character.jealousy >= 60 &&
      character.affection >= 40
    ) {
      context.push(
        `${canonicalName} may become jealous, suspicious, or possessive due to fear of abandonment. These reactions should develop gradually and consistently rather than appearing suddenly.`
      );
    }

    if (
      character.stability < 40 &&
      character.comfort < 30
    ) {
      context.push(
        `${canonicalName} is experiencing significant emotional distress. Depending on the scene and established personality, behavior may become withdrawn, vulnerable, reckless, or emotionally unstable.`
      );
    }

    context.push(
      this.buildStabilityBehaviorContext(
        canonicalName,
        character.stability
      )
    );

    context.push(
      "[END RELATIONSHIP CONTEXT]"
    );

    return context.join("\n");
  }
};

/* =========================================================
   RELATIONSHIP STATUS CARD
   ========================================================= */

const RELStatus = {

  CARD_KEY: "__REL_STATUS__",
  CARD_TYPE: "REL_STATUS",

  round: function (value) {
    return Math.round(Number(value || 0) * 10) / 10;
  },

  getFriendshipLabel: function (value) {
    if (value <= -61) return "Enemy";
    if (value <= -31) return "Persona Non Grata";
    if (value <= 10) return "Neutral";
    if (value <= 30) return "Acquaintance";
    if (value <= 55) return "Friend";
    if (value <= 80) return "Good Friend";
    return "Best Friends";
  },

  getRomanceLabel: function (value) {
    if (value <= 0) return "No Romantic Interest";
    if (value <= 20) return "Mild Attraction";
    if (value <= 40) return "Romantic Interest";
    if (value <= 65) return "Falling in Love";
    if (value <= 85) return "Sweethearts";
    return "Soulmates";
  },

  getTrustLabel: function (value) {
    if (value >= 80) return "Secure";
    if (value >= 60) return "Trusting";
    if (value >= 40) return "Wary";
    if (value >= 20) return "Jealous";
    return "Possessive";
  },

  getAffectionLabel: function (value) {
    if (value < 20) return "Indifferent";
    if (value < 40) return "Fond";
    if (value < 60) return "Attached";
    if (value < 80) return "Deeply Attached";
    return "Devoted";
  },

  getAttractionLabel: function (value) {
    if (value < 10) return "None";
    if (value < 30) return "Curious";
    if (value < 55) return "Attracted";
    if (value < 80) return "Strongly Attracted";
    return "Intense Attraction";
  },

  getComfortLabel: function (value) {
    if (value < 20) return "Distant";
    if (value < 40) return "Cautious";
    if (value < 60) return "Comfortable";
    if (value < 80) return "Close";
    return "Intimate";
  },

  getJealousyLabel: function (value) {
    if (value < 15) return "Calm";
    if (value < 35) return "Alert";
    if (value < 60) return "Jealous";
    if (value < 80) return "Highly Jealous";
    return "Obsessive";
  },

  getStabilityLabel: function (value) {
    if (value >= 80) return "Stable";
    if (value >= 60) return "Strained";
    if (value >= 40) return "Unstable";
    if (value >= 20) return "Distressed";
    return "Crisis";
  },

  buildEntry: function (name) {
    const character = REL.getCharacter(name);

    if (!character) {
      return "";
    }

    const canonicalName =
      REL.getCharacterName(name);

    return [
      `[RELATIONSHIP STATUS — ${canonicalName}]`,
      `Friendship: ${this.round(character.friendship)} — ${this.getFriendshipLabel(character.friendship)}`,
      `Romance: ${this.round(character.romance)} — ${this.getRomanceLabel(character.romance)}`,
      `Trust: ${this.round(character.trust)} — ${this.getTrustLabel(character.trust)}`,
      `Affection: ${this.round(character.affection)} — ${this.getAffectionLabel(character.affection)}`,
      `Attraction: ${this.round(character.attraction)} — ${this.getAttractionLabel(character.attraction)}`,
      `Comfort: ${this.round(character.comfort)} — ${this.getComfortLabel(character.comfort)}`,
      `Jealousy: ${this.round(character.jealousy)} — ${this.getJealousyLabel(character.jealousy)}`,
      `Stability: ${this.round(character.stability)} — ${this.getStabilityLabel(character.stability)}`
    ].join("\n");
  },

  findCard: function () {
    if (!Array.isArray(storyCards)) {
      return -1;
    }

    return storyCards.findIndex(card => {
      if (!card || typeof card !== "object") {
        return false;
      }

      return (
        String(card.keys || "").toLowerCase() ===
          this.CARD_KEY.toLowerCase() &&
        String(card.type || "").toLowerCase() ===
          this.CARD_TYPE.toLowerCase()
      );
    });
  },

  update: function (name) {
    const canonicalName =
      REL.getCharacterName(name);

    if (!canonicalName) {
      return false;
    }

    const entry =
      this.buildEntry(canonicalName);

    if (!entry) {
      return false;
    }

    const index =
      this.findCard();

    if (index >= 0) {
      const card = storyCards[index];

      if (typeof updateStoryCard === "function") {
        updateStoryCard(
          index,
          this.CARD_KEY,
          entry,
          this.CARD_TYPE
        );
      } else {
        card.keys = this.CARD_KEY;
        card.entry = entry;
        card.type = this.CARD_TYPE;
      }

      return true;
    }

    if (typeof addStoryCard === "function") {
      addStoryCard(
        this.CARD_KEY,
        entry,
        this.CARD_TYPE
      );

      return true;
    }

    return false;
  }
};
