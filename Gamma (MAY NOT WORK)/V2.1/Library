          [
            "honest",
            "honestly",
            "tell the truth",
            "truth",
            "explain"
          ]
        ),

      support:
        this.hasAny(
          combined,
          [
            "support",
            "supported",
            "encourage",
            "encouraged",
            "encouragement"
          ]
        ),

      neglect:
        this.hasAny(
          combined,
          [
            "ignore",
            "ignored",
            "neglect",
            "neglected",
            "leave him",
            "leave her"
          ]
        ),

      betrayal:
        this.hasAny(
          combined,
          [
            "betrayed you",
            "betrayed him",
            "betrayed her",
            "betrayal",
            "cheated on you",
            "cheated on him",
            "cheated on her",
            "cheat on you",
            "cheat on him",
            "cheat on her",
            "lied to you",
            "lied to him",
            "lied to her",
            "lie to you",
            "lie to him",
            "lie to her"
          ]
        ),

      argument:
        this.hasAny(
