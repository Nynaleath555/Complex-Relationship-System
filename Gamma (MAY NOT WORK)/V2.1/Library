          [
            "flirt",
            "flirting",
            "flirted",
            "tease flirtatiously",
            "wink",
            "winks",
            "winked"
          ]
        ),

      romanticPhysical:
        this.hasAny(
          combined,
          [
            "kiss",
            "kissed",
            "kissing",
            "cuddle",
            "cuddled",
            "hug",
            "hugged",
            "embrace",
