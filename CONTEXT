/* =========================================================
   COMPLEX REL — CONTEXT
   Inner Self must remain first.
   ========================================================= */

InnerSelf("context");

const modifier = (text) => {

  const relationships =
    REL.init();

  /*
    Make sure the configuration card exists.
  */

  REL.ensureConfigCard();

  const recentHistory =
    history
      .slice(-8)
      .map(
        action => action.text || ""
      )
      .join("\n");

  const combinedText =
    String(text || "") +
    "\n" +
    recentHistory;

  const romanticInterest =
    REL.detectInterest(
      storyCards,
      combinedText
    );

  if (!romanticInterest) {
    return {
      text,
      stop
    };
  }

  REL.ensureCharacter(
    romanticInterest
  );

  const relationshipContext =
    REL.buildContext(
      romanticInterest,
      combinedText
    );

  if (relationshipContext) {

    text +=
      "\n\n" +
      relationshipContext;

  }

  return {
    text,
    stop
  };

};

modifier(text);
