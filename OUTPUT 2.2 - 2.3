InnerSelf("output");

const modifier = (text) => {
  const relationships = REL.init();
  const input = relationships.lastInput || "";
  const output = String(text || "");

  if (!output) return { text: output };

  const recentHistory =
    history.slice(-8).map(action => action.text || "").join("\n");

  const combined =
    input + "\n" + output + "\n" + recentHistory;

  const romanticInterest =
    REL.detectInterest(storyCards, combined);

  if (!romanticInterest) {
    relationships.lastOutput = output;
    return { text: output };
  }

  REL.updateCharacter(
    romanticInterest,
    input,
    output
  );

  relationships.lastOutput = output;
  RELStatus.update(romanticInterest);

  return { text: output };
};

modifier(text);
